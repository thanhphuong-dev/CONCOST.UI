<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.1.0</Version>
    <PackageVersion>1.1.0</PackageVersion>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <RepositoryUrl>https://github.com/thanhphuong-dev/CONCOST.UI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://thanhphuong-dev.github.io/CONCOST.UI/</PackageProjectUrl>
    <Description>A multi-target WPF component library for engineering, CAD, BIM and desktop applications (.NET Framework 4.8, .NET 8, .NET 10).</Description>
    <PackageTags>wpf;controls;ui;engineering;cad;bim;theme;design-system</PackageTags>
    <Authors>CONCOST Ecosystem</Authors>
    <Company>CONCOST</Company>
    <Product>CONCOST WPF UI Library</Product>
    <Copyright>Copyright © 2026 CONCOST</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Strong-name signing (§100). The key lives in build/ and is shared by every project so the
       library, the tests and the showcase all carry the same identity. -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)build\CONCOST.UI.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
</Project>
