<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Semantic Colors -->
    <SolidColorBrush x:Key="CONCOST.Brush.Background" Color="#F8FAFC" />
    <SolidColorBrush x:Key="CONCOST.Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CONCOST.Brush.SurfaceSecondary" Color="#F1F5F9" />
    <SolidColorBrush x:Key="CONCOST.Brush.SurfaceHover" Color="#E2E8F0" />
    <SolidColorBrush x:Key="CONCOST.Brush.SurfacePressed" Color="#CBD5E1" />

    <!-- A panel that floats above the shell: a popover, an inspector, a hovered toolbar tile. The
         paper is a touch cleaner than the shell and never a different hue, so the card reads as the
         same material lifted, not as a second design system. -->
    <SolidColorBrush x:Key="CONCOST.Brush.SurfaceElevated" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CONCOST.Brush.SurfaceSunken" Color="#F1F5F9" />

    <!-- Scrim behind a modal: dims the drawing behind it without pushing it grey-blue. -->
    <SolidColorBrush x:Key="CONCOST.Brush.Overlay" Color="#CCFFFFFF" />

    <SolidColorBrush x:Key="CONCOST.Brush.Border" Color="#E2E8F0" />
    <SolidColorBrush x:Key="CONCOST.Brush.BorderSubtle" Color="#EDF2F7" />
    <SolidColorBrush x:Key="CONCOST.Brush.CanvasBackground" Color="#F8FAFC" />

    <SolidColorBrush x:Key="CONCOST.Brush.BorderSecondary" Color="#CBD5E1" />
    <SolidColorBrush x:Key="CONCOST.Brush.BorderHover" Color="#94A3B8" />
    <SolidColorBrush x:Key="CONCOST.Brush.BorderFocused" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />

    <SolidColorBrush x:Key="CONCOST.Brush.TextPrimary" Color="#0F172A" />
    <SolidColorBrush x:Key="CONCOST.Brush.TextSecondary" Color="#64748B" />
    <SolidColorBrush x:Key="CONCOST.Brush.TextTertiary" Color="#94A3B8" />
    <SolidColorBrush x:Key="CONCOST.Brush.TextDisabled" Color="#CBD5E1" />
    <SolidColorBrush x:Key="CONCOST.Brush.TextInverse" Color="#FFFFFF" />

    <!-- Control Specific Overrides for Light -->
    <SolidColorBrush x:Key="CONCOST.Brush.InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CONCOST.Brush.InputBorder" Color="#CBD5E1" />
    <SolidColorBrush x:Key="CONCOST.Brush.InputHoverBorder" Color="#94A3B8" />

    <!-- Drawing surfaces. A plan grid is ink on paper, not a control border: the border greys are
         dark enough that a thousand of them turn the viewport into graphite paper. -->
    <SolidColorBrush x:Key="CONCOST.Brush.CanvasGrid" Color="#EFF3F8" />
    <SolidColorBrush x:Key="CONCOST.Brush.CanvasGridMajor" Color="#DCE3EC" />
    <SolidColorBrush x:Key="CONCOST.Brush.CanvasAxis" Color="#C7D2E0" />

    <!-- ViewCube. Light grey faces with darker bevel lines, dark grey captions and the blue highlight
         Autodesk uses, not the accent orange: a highlight on the cube means "this is what you will
         click", and the accent is reserved for commands that are already chosen. -->
    <SolidColorBrush x:Key="CONCOST.Brush.ViewCubeFace" Color="#E2E6EC" />
    <SolidColorBrush x:Key="CONCOST.Brush.ViewCubeEdge" Color="#AEB7C4" />
    <SolidColorBrush x:Key="CONCOST.Brush.ViewCubeBorder" Color="#7F8A9A" />
    <SolidColorBrush x:Key="CONCOST.Brush.ViewCubeText" Color="#3E4753" />
    <SolidColorBrush x:Key="CONCOST.Brush.ViewCubeHighlight" Color="#2E86DE" />
    <SolidColorBrush x:Key="CONCOST.Code.Keyword" Color="#0B69C7" />
    <SolidColorBrush x:Key="CONCOST.Code.String" Color="#B45309" />
    <SolidColorBrush x:Key="CONCOST.Code.Comment" Color="#3F7A3F" />
    <SolidColorBrush x:Key="CONCOST.Code.Number" Color="#7C3AED" />
    <SolidColorBrush x:Key="CONCOST.Code.Tag" Color="#0B69C7" />
    <SolidColorBrush x:Key="CONCOST.Code.Attribute" Color="#475569" />
    <SolidColorBrush x:Key="CONCOST.Code.Type" Color="#267F99" />

    <!-- Ribbon. The strip is a shade darker than the paper so the tabs read as chrome and the
         selected tab merges into the panel below it. Hover and pressed are a light blue rather
         than the neutral grey the cards use: on a ribbon the highlight has to say “this command”
         at a glance, and the accent stays reserved for the selected tab. -->
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.TabStrip" Color="#F1F5F9" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.TabSelected" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.PanelBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.Divider" Color="#E2E8F0" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.PanelTitle" Color="#64748B" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ItemForeground" Color="#0F172A" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ItemHover" Color="#E2E8F0" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ItemHoverBorder" Color="#CBD5E1" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ItemPressed" Color="#CBD5E1" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ItemPressedBorder" Color="#94A3B8" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ItemChecked" Color="#FFF7ED" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ItemCheckedBorder" Color="#FED7AA" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ItemDisabledForeground" Color="#94A3B8" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ContextualAccent" Color="#FF7900" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ContextualTabAccent" Color="#FF7900" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ContextualModify" Color="{DynamicResource CONCOST.Color.Primary}" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ToolTipBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ToolTipText" Color="#0F172A" />

    <!-- Classic project tree. The selection is a band across the row, the way Explorer and
         Revit draw it, so it is its own pair rather than the accent used by a pill selection. -->

    <!-- One tint per node kind. All-grey glyphs at 13 px are indistinguishable, which is why
         a schedule and a level read as the same little square. -->
    <SolidColorBrush x:Key="CONCOST.Brush.Node.View" Color="#2563EB" />
    <SolidColorBrush x:Key="CONCOST.Brush.Node.Sheet" Color="#059669" />
    <SolidColorBrush x:Key="CONCOST.Brush.Node.Schedule" Color="#7C3AED" />
    <SolidColorBrush x:Key="CONCOST.Brush.Node.Family" Color="#D97706" />
    <SolidColorBrush x:Key="CONCOST.Brush.Node.Level" Color="#0D9488" />

    <!-- Shadow: a whisper of ink under a card. The elevation behaviour feeds this colour to a
         drop shadow and deepens it per level, so the token itself stays almost invisible. -->
    <Color x:Key="CONCOST.Color.Shadow">#1A0F172A</Color>
    <Color x:Key="CONCOST.Color.ShadowStrong">#330F172A</Color>

    <!-- Dedicated Light Primary Soft Tint (Tailwind Orange 50/100) -->
    <SolidColorBrush x:Key="CONCOST.Brush.PrimarySoftLight" Color="#FFF7ED" />
    <SolidColorBrush x:Key="CONCOST.Brush.PrimarySoftBorder" Color="#FED7AA" />
    <SolidColorBrush x:Key="CONCOST.Brush.PrimarySoftForeground" Color="#C2410C" />

</ResourceDictionary>
