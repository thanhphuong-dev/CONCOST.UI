<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette sampled from Revit 2024.3 UIFramework.dll: FullLightTheme + ThemeColorLight. -->
    <Color x:Key="CONCOST.Revit.Light.ChromeBackground">#FFD9D9D9</Color>
    <Color x:Key="CONCOST.Revit.Light.ChromeForeground">#FF3C3C3C</Color>
    <Color x:Key="CONCOST.Revit.Light.ClientArea">#FFEEEEEE</Color>
    <Color x:Key="CONCOST.Revit.Light.RibbonPanel">#FFF5F5F5</Color>
    <Color x:Key="CONCOST.Revit.Light.SelectionFill">#59808080</Color>
    <Color x:Key="CONCOST.Revit.Light.SelectionBorder">#FF2762B9</Color>
    <Color x:Key="CONCOST.Revit.Light.Focus">#FF0696D7</Color>
    <Color x:Key="CONCOST.Revit.Light.Hyperlink">#FF006EAF</Color>
    <Color x:Key="CONCOST.Revit.Light.Progress">#FF38ABDF</Color>

    <SolidColorBrush x:Key="CONCOST.Brush.Primary" Color="#FF0696D7" />
    <SolidColorBrush x:Key="CONCOST.Brush.PrimaryHover" Color="#FF0696D7" />
    <SolidColorBrush x:Key="CONCOST.Brush.PrimaryPressed" Color="#FF0696D7" />
    <SolidColorBrush x:Key="CONCOST.Brush.PrimaryLight" Color="#99CDEAF7" />
    <SolidColorBrush x:Key="CONCOST.Brush.PrimaryDark" Color="#FF0696D7" />
    <SolidColorBrush x:Key="CONCOST.Brush.PrimarySoft" Color="#99CDEAF7" />

    <SolidColorBrush x:Key="CONCOST.Brush.Background" Color="#FFEEEEEE" />
    <SolidColorBrush x:Key="CONCOST.Brush.Surface" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CONCOST.Brush.SurfaceSecondary" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="CONCOST.Brush.SurfaceHover" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="CONCOST.Brush.SurfacePressed" Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="CONCOST.Brush.SurfaceElevated" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CONCOST.Brush.SurfaceSunken" Color="#FFD9D9D9" />
    <SolidColorBrush x:Key="CONCOST.Brush.Overlay" Color="#CCFFFFFF" />

    <SolidColorBrush x:Key="CONCOST.Brush.Border" Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="CONCOST.Brush.BorderSubtle" Color="#FFECECEC" />
    <SolidColorBrush x:Key="CONCOST.Brush.CanvasBackground" Color="#FFEEEEEE" />
    <SolidColorBrush x:Key="CONCOST.Brush.ViewportBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CONCOST.Brush.BorderSecondary" Color="#FFB7B7B7" />
    <SolidColorBrush x:Key="CONCOST.Brush.BorderHover" Color="#FF808080" />
    <SolidColorBrush x:Key="CONCOST.Brush.BorderFocused" Color="#FF0696D7" />
    <SolidColorBrush x:Key="CONCOST.Brush.SelectionBackground" Color="#59808080" />
    <SolidColorBrush x:Key="CONCOST.Brush.SelectionBorder" Color="#FF2762B9" />
    <SolidColorBrush x:Key="CONCOST.Brush.Hyperlink" Color="#FF006EAF" />
    <SolidColorBrush x:Key="CONCOST.Brush.Progress" Color="#FF38ABDF" />

    <SolidColorBrush x:Key="CONCOST.Brush.TextPrimary" Color="#FF303030" />
    <SolidColorBrush x:Key="CONCOST.Brush.TextSecondary" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="CONCOST.Brush.TextTertiary" Color="#FF666666" />
    <SolidColorBrush x:Key="CONCOST.Brush.TextDisabled" Color="#FF5A5A5A" />
    <SolidColorBrush x:Key="CONCOST.Brush.TextInverse" Color="#FFF5F5F5" />

    <SolidColorBrush x:Key="CONCOST.Brush.InputBackground" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="CONCOST.Brush.InputBorder" Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="CONCOST.Brush.InputHoverBorder" Color="#FF808080" />

    <SolidColorBrush x:Key="CONCOST.Brush.CanvasGrid" Color="#FFECECEC" />
    <SolidColorBrush x:Key="CONCOST.Brush.CanvasGridMajor" Color="#FFDDDDDD" />
    <SolidColorBrush x:Key="CONCOST.Brush.CanvasAxis" Color="#FFB0B0B0" />

    <SolidColorBrush x:Key="CONCOST.Brush.ViewCubeFace" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="CONCOST.Brush.ViewCubeEdge" Color="#FFB0B0B0" />
    <SolidColorBrush x:Key="CONCOST.Brush.ViewCubeBorder" Color="#FF808080" />
    <SolidColorBrush x:Key="CONCOST.Brush.ViewCubeText" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="CONCOST.Brush.ViewCubeHighlight" Color="#FF2762B9" />

    <SolidColorBrush x:Key="CONCOST.Code.Keyword" Color="#0B69C7" />
    <SolidColorBrush x:Key="CONCOST.Code.String" Color="#B45309" />
    <SolidColorBrush x:Key="CONCOST.Code.Comment" Color="#3F7A3F" />
    <SolidColorBrush x:Key="CONCOST.Code.Number" Color="#7C3AED" />
    <SolidColorBrush x:Key="CONCOST.Code.Tag" Color="#0B69C7" />
    <SolidColorBrush x:Key="CONCOST.Code.Attribute" Color="#475569" />

    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.TabStrip" Color="#FFD9D9D9" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.TabSelected" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.PanelBackground" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.Divider" Color="#FFDDDDDD" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.PanelTitle" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ItemForeground" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ItemHover" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ItemHoverBorder" Color="#FFBBBBBB" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ItemPressed" Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ItemPressedBorder" Color="#FF0696D7" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ItemChecked" Color="#99CDEAF7" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ItemCheckedBorder" Color="#800696D7" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ItemDisabledForeground" Color="#663C3C3C" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ContextualAccent" Color="#FF0696D7" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ContextualTabAccent" Color="#FF0696D7" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ContextualModify" Color="{DynamicResource CONCOST.Color.Primary}" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ToolTipBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CONCOST.Brush.Ribbon.ToolTipText" Color="#FF3C3C3C" />

    <!-- Revit view tabs keep their surfaces in the light chrome palette. -->
    <SolidColorBrush x:Key="CONCOST.Brush.TabBar.Background" Color="#FFD9D9D9" />
    <SolidColorBrush x:Key="CONCOST.Brush.TabBar.TabActiveBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CONCOST.Brush.TabBar.TabInactiveBackground" Color="#FFEEEEEE" />
    <SolidColorBrush x:Key="CONCOST.Brush.TabBar.TabHoverBackground" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="CONCOST.Brush.TabBar.TabActiveBorder" Color="#FF0696D7" />
    <SolidColorBrush x:Key="CONCOST.Brush.TabBar.TabInactiveBorder" Color="#FFCCCCCC" />
    <SolidColorBrush x:Key="CONCOST.Brush.TabBar.TabTextActive" Color="#FF303030" />
    <SolidColorBrush x:Key="CONCOST.Brush.TabBar.TabTextInactive" Color="#FF5A5A5A" />
    <SolidColorBrush x:Key="CONCOST.Brush.TabBar.CloseButtonHover" Color="#FFE81123" />

    <SolidColorBrush x:Key="CONCOST.Brush.Node.View" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="CONCOST.Brush.Node.Sheet" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="CONCOST.Brush.Node.Schedule" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="CONCOST.Brush.Node.Family" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="CONCOST.Brush.Node.Level" Color="#FF3C3C3C" />

    <Color x:Key="CONCOST.Color.Shadow">#1A000000</Color>
    <Color x:Key="CONCOST.Color.ShadowStrong">#33000000</Color>
    <SolidColorBrush x:Key="CONCOST.Brush.PrimarySoftLight" Color="#99CDEAF7" />
    <SolidColorBrush x:Key="CONCOST.Brush.PrimarySoftBorder" Color="#800696D7" />
    <SolidColorBrush x:Key="CONCOST.Brush.PrimarySoftForeground" Color="#FF3C3C3C" />

</ResourceDictionary>
