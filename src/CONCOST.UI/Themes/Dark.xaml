<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Semantic Colors -->
    <SolidColorBrush x:Key="CONCOST.Brush.Background" Color="#0B0F19" />
    <SolidColorBrush x:Key="CONCOST.Brush.Surface" Color="#151D2A" />
    <SolidColorBrush x:Key="CONCOST.Brush.SurfaceSecondary" Color="#1E293B" />
    <SolidColorBrush x:Key="CONCOST.Brush.SurfaceHover" Color="#273549" />
    <SolidColorBrush x:Key="CONCOST.Brush.SurfacePressed" Color="#334155" />

    <SolidColorBrush x:Key="CONCOST.Brush.Border" Color="#263346" />
    <SolidColorBrush x:Key="CONCOST.Brush.BorderSecondary" Color="#334155" />
    <SolidColorBrush x:Key="CONCOST.Brush.BorderHover" Color="#475569" />
    <SolidColorBrush x:Key="CONCOST.Brush.BorderFocused" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />

    <SolidColorBrush x:Key="CONCOST.Brush.TextPrimary" Color="#F8FAFC" />
    <SolidColorBrush x:Key="CONCOST.Brush.TextSecondary" Color="#94A3B8" />
    <SolidColorBrush x:Key="CONCOST.Brush.TextTertiary" Color="#64748B" />
    <SolidColorBrush x:Key="CONCOST.Brush.TextDisabled" Color="#475569" />
    <SolidColorBrush x:Key="CONCOST.Brush.TextInverse" Color="#0F172A" />

    <!-- Control Specific Overrides for Dark -->
    <SolidColorBrush x:Key="CONCOST.Brush.InputBackground" Color="#111827" />
    <SolidColorBrush x:Key="CONCOST.Brush.InputBorder" Color="#263346" />
    <SolidColorBrush x:Key="CONCOST.Brush.InputHoverBorder" Color="#475569" />

    <!-- Shadow -->
    <Color x:Key="CONCOST.Color.Shadow">#60000000</Color>

</ResourceDictionary>
