  <Style x:Key="CONCOST.RangeSlider.Base" TargetType="{x:Type controls:RangeSlider}">
    <Setter Property="Height" Value="32" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Foreground" Value="{DynamicResource CONCOST.Brush.TextPrimary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:RangeSlider}">
          <Grid VerticalAlignment="Center">
            <Border Name="PART_Track" Height="6" CornerRadius="3" Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="0.5" />
            <Border Name="PART_ActiveTrack" Height="6" CornerRadius="3" Background="{DynamicResource CONCOST.Brush.Primary}" HorizontalAlignment="Left" />
            <Thumb Name="PART_StartThumb" Width="18" Height="18" HorizontalAlignment="Left" Cursor="Hand">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type Thumb}">
                  <Border Name="ThumbBorder" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource CONCOST.Brush.Surface}" BorderBrush="{DynamicResource CONCOST.Brush.Primary}" BorderThickness="2.5" Effect="{DynamicResource CONCOST.Shadow.Depth2}" />
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
