              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <ContentPresenter Grid.Row="0" Content="{TemplateBinding controls:SideMenu.Header}" Margin="0,0,0,8" HorizontalAlignment="Center" />
