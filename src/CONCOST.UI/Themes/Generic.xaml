  <!-- ============================ Ribbon screen tip ============================ -->
  <Style x:Key="CONCOST.RibbonToolTip.Base" TargetType="{x:Type ribbon:RibbonToolTip}">
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ribbon:RibbonToolTip}">
          <Border Background="{DynamicResource CONCOST.Brush.Surface}" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="10,8" MaxWidth="340" SnapsToDevicePixels="True">
            <Border.Effect>
              <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.18" Color="#101828" />
            </Border.Effect>
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Grid.Column="0" Text="{TemplateBinding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource CONCOST.Brush.TextPrimary}" />
                <TextBlock x:Name="GestureText" Grid.Column="1" Text="{TemplateBinding GestureText}" Margin="16,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource CONCOST.Brush.TextTertiary}" />
              </Grid>
              <Image x:Name="PreviewImage" Source="{TemplateBinding Preview}" MaxHeight="64" Margin="0,8,0,0" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock x:Name="DescriptionText" Text="{TemplateBinding Description}" Margin="0,4,0,0" FontSize="11.5" TextWrapping="Wrap" LineHeight="16" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" />
              <TextBlock x:Name="FooterText" Text="{TemplateBinding Footer}" Margin="0,6,0,0" FontSize="10.5" Foreground="{DynamicResource CONCOST.Brush.TextTertiary}" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Description" Value="">
              <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="GestureText" Value="">
              <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Footer" Value="">
              <Setter TargetName="FooterText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Preview" Value="{x:Null}">
              <Setter TargetName="PreviewImage" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Ribbon quick access ============================ -->
  
  <Style x:Key="CONCOST.RibbonQuickAccessToolBar.Base" TargetType="{x:Type ribbon:RibbonQuickAccessToolBar}">
    <Setter Property="Height" Value="{DynamicResource CONCOST.Ribbon.QuickAccessHeight}" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ribbon:RibbonQuickAccessToolBar}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
            <ItemsPresenter VerticalAlignment="Center" />

            <ToggleButton Style="{x:Null}" x:Name="Chevron" Width="20" Height="22" Margin="5,0,0,0" VerticalAlignment="Center" Focusable="False" Background="Transparent" BorderThickness="0" ToolTip="Customize Quick Access Toolbar" IsChecked="{Binding IsCustomizeOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                  <Border x:Name="Cb" Background="Transparent" CornerRadius="3">
                    <Path Data="M0,0 L9,0 L4.5,4 Z" Fill="{DynamicResource CONCOST.Brush.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Cb" Property="Background" Value="{DynamicResource CONCOST.Brush.SurfaceHover}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Cb" Property="Background" Value="{DynamicResource CONCOST.Brush.SurfacePressed}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>

            <Popup x:Name="PART_Customize" IsOpen="{Binding IsCustomizeOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Placement="Bottom" PlacementTarget="{Binding ElementName=Chevron}" HorizontalOffset="-8" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True">
              <Border Background="{DynamicResource CONCOST.Brush.Surface}" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="1" CornerRadius="6" MinWidth="278" SnapsToDevicePixels="True">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.22" Color="#101828" />
                </Border.Effect>
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Text="Customize Quick Access Toolbar" Margin="12,10,12,4" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" />

                  <ScrollViewer Grid.Row="1" MaxHeight="360" Padding="4,0,4,4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentPresenter Content="{Binding CustomizeMenu, RelativeSource={RelativeSource TemplatedParent}}" />
                  </ScrollViewer>

                  <Border Grid.Row="2" BorderBrush="{DynamicResource CONCOST.Brush.BorderSecondary}" BorderThickness="0,1,0,0" Padding="6,4">
                    <Button Command="{x:Static ribbon:RibbonQuickAccessToolBar.ClearPinsCommand}" Content="Remove all" HorizontalAlignment="Left" Padding="8,3" Background="Transparent" BorderThickness="0" FontSize="11" Cursor="Hand" />
                  </Border>
                </Grid>
              </Border>
            </Popup>
          </StackPanel>
          <ControlTemplate.Triggers>
            <!-- An empty strip must not leave a lone chevron floating in the tab row. -->
            <Trigger Property="HasItems" Value="False">
              <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Ribbon application menu ============================ -->
  <Style x:Key="CONCOST.RibbonApplicationMenu.Base" TargetType="{x:Type ribbon:RibbonApplicationMenu}">
    <!-- A neutral block, not an accent slab. A solid primary rectangle is the loudest thing in the
         whole ribbon and it competes with the accent, which belongs to the selected tab. Hosts that
         want the coloured File block back set Background / Foreground on the control. -->
    <Setter Property="Background" Value="{DynamicResource CONCOST.Brush.SurfaceSecondary}" />
    <Setter Property="Foreground" Value="{DynamicResource CONCOST.Brush.TextPrimary}" />
    <Setter Property="Height" Value="{DynamicResource CONCOST.Ribbon.QuickAccessHeight}" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ribbon:RibbonApplicationMenu}">
          <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <TextBlock Text="{TemplateBinding Header}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
            </Border>

            <Popup x:Name="Panel" IsOpen="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Placement="Bottom" PlacementTarget="{Binding ElementName=Bd}" StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-5" VerticalOffset="2">
              <Border Background="{DynamicResource CONCOST.Brush.Surface}" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="1" CornerRadius="8" MinWidth="420" SnapsToDevicePixels="True">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="24" ShadowDepth="5" Direction="270" Opacity="0.22" Color="#101828" />
                </Border.Effect>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" Margin="6,6,6,6">
                    <ItemsControl x:Name="PrimaryItems" ItemsSource="{Binding Items, RelativeSource={RelativeSource TemplatedParent}}" />
                    <Border x:Name="FooterDivider" Height="1" Margin="6,5" Background="{DynamicResource CONCOST.Brush.BorderSecondary}" />
                    <ItemsControl x:Name="FooterCommands" ItemsSource="{TemplateBinding FooterItems}" />
                  </StackPanel>

                  <Border Grid.Column="1" MinWidth="210" Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}" CornerRadius="0,8,8,0" Padding="14,12">
                    <StackPanel>
                      <TextBlock Text="{TemplateBinding RecentHeader}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource CONCOST.Brush.TextTertiary}" Margin="0,0,0,6" />
                      <ItemsControl x:Name="RecentList" ItemsSource="{TemplateBinding RecentItems}" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CONCOST.Brush.SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsOpen" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CONCOST.Brush.SurfacePressed}" />
            </Trigger>
            <Trigger Property="RecentItems" Value="{x:Null}">
              <Setter TargetName="RecentList" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="FooterItems" Value="{x:Null}">
              <Setter TargetName="FooterDivider" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="FooterCommands" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The contextual group is a logical container only; the strip panel paints its band. -->
  <Style x:Key="CONCOST.RibbonContextualTabGroup.Base" TargetType="{x:Type ribbon:RibbonContextualTabGroup}">
    <Setter Property="Template">
