  <Style x:Key="CONCOST.StepBarItem.Base" TargetType="{x:Type controls:StepBarItem}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:StepBarItem}">
          <Grid VerticalAlignment="Top" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
              <RowDefinition Height="36" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Ellipse Width="44" Height="36" Fill="{DynamicResource CONCOST.Brush.Surface}" />
              <Border Name="circleBorder" Width="30" Height="30" CornerRadius="15" BorderThickness="2" BorderBrush="{DynamicResource CONCOST.Brush.Border}" Background="{DynamicResource CONCOST.Brush.Surface}" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                <Grid>
                  <TextBlock Name="numberBlock" FontWeight="Normal" FontSize="12.5" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Index, RelativeSource={RelativeSource TemplatedParent}}" />
                  <icons:Icon x:Name="checkIcon" Kind="Check" Width="13" Height="13" Foreground="{DynamicResource CONCOST.Brush.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
              </Border>
            </Grid>
            <ContentPresenter Name="titlePresenter" Grid.Row="1" HorizontalAlignment="Center" Margin="0,8,0,0">
              <FrameworkElement.Resources>
                <ResourceDictionary>
                  <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Foreground" Value="{DynamicResource CONCOST.Brush.TextSecondary}" />
                    <Setter Property="TextBlock.TextAlignment" Value="Center" />
                  </Style>
                </ResourceDictionary>
              </FrameworkElement.Resources>
            </ContentPresenter>
            <TextBlock Name="descBlock" Grid.Row="2" Text="{TemplateBinding controls:StepBarItem.Description}" FontSize="11.5" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" TextAlignment="Center" Margin="0,2,0,0" HorizontalAlignment="Center" Opacity="0.8" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="controls:StepBarItem.Status" Value="UnderWay">
              <Setter TargetName="circleBorder" Value="{DynamicResource CONCOST.Brush.Primary}" Property="Border.BorderBrush" />
              <Setter TargetName="circleBorder" Value="{DynamicResource CONCOST.Brush.Primary}" Property="Border.Background" />
              <Setter TargetName="numberBlock" Property="TextBlock.Foreground" Value="#FFFFFFFF" />
              <Setter TargetName="numberBlock" Property="Visibility" Value="Visible" />
              <Setter TargetName="checkIcon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="controls:StepBarItem.Status" Value="Complete">
              <Setter TargetName="circleBorder" Value="{DynamicResource CONCOST.Brush.Primary}" Property="Border.BorderBrush" />
              <Setter TargetName="circleBorder" Value="{DynamicResource CONCOST.Brush.Surface}" Property="Border.Background" />
              <Setter TargetName="numberBlock" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="checkIcon" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="controls:StepBarItem.Status" Value="Waiting">
              <Setter TargetName="circleBorder" Value="{DynamicResource CONCOST.Brush.Border}" Property="Border.BorderBrush" />
              <Setter TargetName="circleBorder" Value="{DynamicResource CONCOST.Brush.SurfaceSecondary}" Property="Border.Background" />
              <Setter TargetName="numberBlock" Value="{DynamicResource CONCOST.Brush.TextSecondary}" Property="TextBlock.Foreground" />
              <Setter TargetName="numberBlock" Property="Visibility" Value="Visible" />
              <Setter TargetName="checkIcon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="controls:StepBarItem.Status" Value="Error">
              <Setter TargetName="circleBorder" Value="{DynamicResource CONCOST.Brush.Danger}" Property="Border.BorderBrush" />
              <Setter TargetName="circleBorder" Value="{DynamicResource CONCOST.Brush.Danger}" Property="Border.Background" />
              <Setter TargetName="numberBlock" Property="TextBlock.Foreground" Value="#FFFFFFFF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type controls:StepBarItem}" TargetType="{x:Type controls:StepBarItem}" BasedOn="{StaticResource CONCOST.StepBarItem.Base}" />
  <Style x:Key="CONCOST.StepBar.Base" TargetType="{x:Type controls:StepBar}">
