            <Ellipse Name="Dot2" Width="{TemplateBinding controls:LoadingLine.DotSize}" Height="{TemplateBinding controls:LoadingLine.DotSize}" Fill="{TemplateBinding Control.Foreground}" Margin="3,0" RenderTransformOrigin="0.5,0.5">
              <UIElement.RenderTransform>
