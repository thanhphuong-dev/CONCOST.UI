    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style x:Key="CONCOST.CalendarWithClock.Borderless" TargetType="{x:Type controls:CalendarWithClock}" BasedOn="{StaticResource CONCOST.CalendarWithClock.Base}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style x:Key="{x:Type controls:CalendarWithClock}" TargetType="{x:Type controls:CalendarWithClock}" BasedOn="{StaticResource CONCOST.CalendarWithClock.Base}" />
  <Style x:Key="CONCOST.ColorPicker.Base" TargetType="{x:Type controls:ColorPicker}">
    <Setter Property="Width" Value="280" />
    <Setter Property="Background" Value="{DynamicResource CONCOST.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CONCOST.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:ColorPicker}">
          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="10" Padding="16" SnapsToDevicePixels="True">
            <StackPanel>
              <Border CornerRadius="8" Height="140" Margin="0,0,0,12" ClipToBounds="True" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="1">
                <Grid>
                  <Rectangle Name="PART_HueBackgroundRect" Fill="#FFFF0000" />
                  <Rectangle>
                    <Shape.Fill>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFFFFFF" Offset="0" />
                        <GradientStop Color="#00FFFFFF" Offset="1" />
                      </LinearGradientBrush>
                    </Shape.Fill>
                  </Rectangle>
                  <Rectangle>
                    <Shape.Fill>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#FF000000" Offset="1" />
                      </LinearGradientBrush>
                    </Shape.Fill>
                  </Rectangle>
                  <Canvas Name="PART_SVCanvas" Background="#00FFFFFF">
                    <Border Name="PART_SVThumb" Width="14" Height="14" CornerRadius="7" BorderBrush="#FFFFFFFF" BorderThickness="2" Canvas.Left="50" Canvas.Top="50">
                      <UIElement.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.5" />
                      </UIElement.Effect>
                    </Border>
                  </Canvas>
                </Grid>
              </Border>
              <Slider Name="PART_HueSlider" Minimum="0" Maximum="360" Value="0" Height="14" Margin="0,0,0,10">
                <Control.Template>
                  <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid>
                      <Border CornerRadius="6" Height="12" ClipToBounds="True">
                        <Border.Background>
                          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF0000" Offset="0.0" />
                            <GradientStop Color="#FFFF00" Offset="0.17" />
                            <GradientStop Color="#00FF00" Offset="0.33" />
                            <GradientStop Color="#00FFFF" Offset="0.5" />
                            <GradientStop Color="#0000FF" Offset="0.67" />
                            <GradientStop Color="#FF00FF" Offset="0.83" />
                            <GradientStop Color="#FF0000" Offset="1.0" />
                          </LinearGradientBrush>
                        </Border.Background>
                      </Border>
                      <Track Name="PART_Track">
                        <Track.Thumb>
                          <Thumb Width="14" Height="14" Cursor="Hand">
                            <Control.Template>
                              <ControlTemplate>
                                <Border CornerRadius="7" Background="#FFFFFFFF" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="1.5" />
                              </ControlTemplate>
                            </Control.Template>
                          </Thumb>
                        </Track.Thumb>
                      </Track>
                    </Grid>
                  </ControlTemplate>
                </Control.Template>
              </Slider>
              <Slider Name="PART_AlphaSlider" Minimum="0" Maximum="255" Value="255" Height="14" Margin="0,0,0,12">
                <Control.Template>
                  <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid>
                      <Border CornerRadius="6" Height="12" Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="1" />
                      <Track Name="PART_Track">
                        <Track.Thumb>
                          <Thumb Width="14" Height="14" Cursor="Hand">
                            <Control.Template>
                              <ControlTemplate>
                                <Border CornerRadius="7" Background="#FFFFFFFF" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="1.5" />
                              </ControlTemplate>
                            </Control.Template>
                          </Thumb>
                        </Track.Thumb>
                      </Track>
                    </Grid>
                  </ControlTemplate>
                </Control.Template>
              </Slider>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="36" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="6" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="1">
                  <Border.Background>
                    <SolidColorBrush Color="{Binding SelectedColor, RelativeSource={RelativeSource AncestorType=controls:ColorPicker}}" />
                  </Border.Background>
                </Border>
                <TextBox Grid.Column="1" Margin="8,0,0,0" Height="34" Style="{DynamicResource CONCOST.TextBox.Base}" FontWeight="Normal" FontFamily="Consolas, monospace" Text="{Binding HexCode, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=controls:ColorPicker}}" />
              </Grid>
              <TextBlock Text="Preset Palette" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" Margin="0,0,0,6" />
              <ItemsControl ItemsSource="{Binding PresetColors, RelativeSource={RelativeSource AncestorType=controls:ColorPicker}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="5" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Width="22" Height="22" Margin="2" Cursor="Hand" BorderThickness="1" BorderBrush="{DynamicResource CONCOST.Brush.Border}">
                      <Control.Background>
                        <SolidColorBrush Color="{Binding}" />
                      </Control.Background>
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Border Background="{TemplateBinding Control.Background}" CornerRadius="4" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" />
                        </ControlTemplate>
                      </Control.Template>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type controls:ColorPicker}" TargetType="{x:Type controls:ColorPicker}" BasedOn="{StaticResource CONCOST.ColorPicker.Base}" />
  <Style x:Key="CONCOST.SplitButton.Base" TargetType="{x:Type controls:SplitButton}">
    <Setter Property="Height" Value="34" />
    <Setter Property="Background" Value="{DynamicResource CONCOST.Brush.Primary}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource CONCOST.Brush.Primary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="controls:SplitButton.CornerRadius" Value="6" />
    <Setter Property="controls:SplitButton.IconSize" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="attached:BorderElement.CornerRadius" Value="6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:SplitButton}">
          <Grid>
            <Border Name="RootBorder" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="{TemplateBinding controls:SplitButton.CornerRadius}" SnapsToDevicePixels="True" ClipToBounds="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Name="PART_ActionButton" Grid.Column="0" Background="#00FFFFFF" BorderThickness="0" Foreground="{TemplateBinding Control.Foreground}" Padding="14,0,10,0" Cursor="Hand" FontSize="{TemplateBinding Control.FontSize}" FontWeight="Normal" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" attached:BorderElement.CornerRadius="5,0,0,5">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border Name="actionBtnBorder" Background="#00FFFFFF" CornerRadius="{TemplateBinding attached:BorderElement.CornerRadius}" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <icons:Icon x:Name="PART_ActionIconLeft" Margin="0,0,8,0" Kind="{Binding Icon, RelativeSource={RelativeSource AncestorType=controls:SplitButton}}" Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=controls:SplitButton}}" Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=controls:SplitButton}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:SplitButton}}" />
                          <ContentPresenter VerticalAlignment="Center" Content="{Binding Content, RelativeSource={RelativeSource AncestorType=controls:SplitButton}}" />
                          <icons:Icon x:Name="PART_ActionIconRight" Margin="8,0,0,0" Visibility="Collapsed" Kind="{Binding Icon, RelativeSource={RelativeSource AncestorType=controls:SplitButton}}" Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=controls:SplitButton}}" Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=controls:SplitButton}}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:SplitButton}}" />
                        </StackPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter TargetName="actionBtnBorder" Property="Border.Background" Value="#1AFFFFFF" />
                        </Trigger>
                        <Trigger Property="ButtonBase.IsPressed" Value="True">
                          <Setter TargetName="actionBtnBorder" Property="Border.Background" Value="#2E000000" />
                        </Trigger>
                        <DataTrigger Value="None" Binding="{Binding Icon, RelativeSource={RelativeSource AncestorType=controls:SplitButton}}">
                          <Setter TargetName="PART_ActionIconLeft" Property="Visibility" Value="Collapsed" />
                          <Setter TargetName="PART_ActionIconRight" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Value="Right" Binding="{Binding IconPlacement, RelativeSource={RelativeSource AncestorType=controls:SplitButton}}">
                          <Setter TargetName="PART_ActionIconLeft" Property="Visibility" Value="Collapsed" />
                          <Setter TargetName="PART_ActionIconRight" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Control.Template>
                </Button>
                <Border Name="PART_Divider" Grid.Column="1" Width="1" Background="{TemplateBinding Control.Foreground}" Opacity="0.25" Margin="0,6" />
                <ToggleButton Name="PART_DropDownButton" Grid.Column="2" Width="30" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" attached:BorderElement.CornerRadius="0,5,5,0" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                      <Border Name="toggleBtnBorder" Background="#00FFFFFF" CornerRadius="{TemplateBinding attached:BorderElement.CornerRadius}" SnapsToDevicePixels="True">
                        <icons:Icon x:Name="chevronIcon" Kind="ChevronDown" Width="14" Height="14" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=controls:SplitButton}}">
                          <UIElement.RenderTransform>
                            <RotateTransform x:Name="chevronRotate" Angle="0" />
                          </UIElement.RenderTransform>
                        </icons:Icon>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter TargetName="toggleBtnBorder" Property="Border.Background" Value="#1AFFFFFF" />
                        </Trigger>
                        <Trigger Property="ButtonBase.IsPressed" Value="True">
                          <Setter TargetName="toggleBtnBorder" Property="Border.Background" Value="#2E000000" />
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                          <TriggerBase.EnterActions>
                            <BeginStoryboard>
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="chevronRotate" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.18">
                                  <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                  </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                              </Storyboard>
                            </BeginStoryboard>
                          </TriggerBase.EnterActions>
                          <TriggerBase.ExitActions>
                            <BeginStoryboard>
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="chevronRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.18">
                                  <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                  </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                              </Storyboard>
                            </BeginStoryboard>
                          </TriggerBase.ExitActions>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Control.Template>
                </ToggleButton>
              </Grid>
            </Border>
            <Popup Name="PART_Popup" Placement="{TemplateBinding controls:SplitButton.Placement}" StaysOpen="{TemplateBinding controls:SplitButton.StaysOpen}" AllowsTransparency="True" PopupAnimation="Fade" PlacementTarget="{Binding ElementName=RootBorder}" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <Border Background="{DynamicResource CONCOST.Brush.Surface}" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="1" CornerRadius="8" Margin="0,4,8,8" Padding="6" MinWidth="180" MaxHeight="{TemplateBinding controls:SplitButton.MaxDropDownHeight}" SnapsToDevicePixels="True" Effect="{DynamicResource CONCOST.Shadow.Depth2}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ContentPresenter Content="{TemplateBinding controls:SplitButton.DropDownContent}" ContentTemplate="{TemplateBinding controls:SplitButton.DropDownContentTemplate}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="controls:SplitButton.DropDownButtonPosition" Value="Left">
              <Setter TargetName="PART_ActionButton" Property="Grid.Column" Value="2" />
              <Setter TargetName="PART_ActionButton" Property="Padding" Value="10,0,14,0" />
              <Setter TargetName="PART_ActionButton" Property="attached:BorderElement.CornerRadius" Value="0,5,5,0" />
              <Setter TargetName="PART_DropDownButton" Property="Grid.Column" Value="0" />
              <Setter TargetName="PART_DropDownButton" Property="attached:BorderElement.CornerRadius" Value="5,0,0,5" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="RootBorder" Property="UIElement.Opacity" Value="0.45" />
              <Setter Property="FrameworkElement.Cursor" Value="No" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CONCOST.SplitButton.Primary" TargetType="{x:Type controls:SplitButton}" BasedOn="{StaticResource CONCOST.SplitButton.Base}" />
