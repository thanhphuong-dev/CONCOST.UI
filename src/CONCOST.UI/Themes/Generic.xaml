                                <DataTemplate>
                                  <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="150" />
                                      <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="Normal" FontSize="12" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding DisplayName}" ToolTip="{Binding Description}" />
                                    <Grid Grid.Column="1">
                                      <Grid.Style>
                                        <Style TargetType="{x:Type Grid}">
                                          <Setter Property="IsEnabled" Value="True" />
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                              <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </Grid.Style>
                                      <TextBox FontSize="12" Height="30" Padding="8,0" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" ToolTip="{Binding ValidationError}">
                                        <FrameworkElement.Style>
                                          <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource CONCOST.TextBox.Base}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                              <DataTrigger Value="Boolean" Binding="{Binding EditorType}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                              </DataTrigger>
                                              <DataTrigger Value="Enum" Binding="{Binding EditorType}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                              </DataTrigger>
                                              <DataTrigger Value="HorizontalAlignment" Binding="{Binding EditorType}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                              </DataTrigger>
                                              <DataTrigger Value="VerticalAlignment" Binding="{Binding EditorType}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                              </DataTrigger>
                                              <DataTrigger Value="ImageSource" Binding="{Binding EditorType}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                              </DataTrigger>
                                            </Style.Triggers>
                                          </Style>
                                        </FrameworkElement.Style>
                                      </TextBox>
                                      <CheckBox IsChecked="{Binding IsBoolTrue, Mode=TwoWay}" Content="{Binding Value}">
                                        <FrameworkElement.Style>
                                          <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource CONCOST.CheckBox.Base}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                              <DataTrigger Value="Boolean" Binding="{Binding EditorType}">
                                                <Setter Property="Visibility" Value="Visible" />
                                              </DataTrigger>
                                            </Style.Triggers>
                                          </Style>
                                        </FrameworkElement.Style>
                                      </CheckBox>
                                      <ComboBox Height="30" FontSize="12" ItemsSource="{Binding EnumOptions}" SelectedItem="{Binding Value, Mode=TwoWay}">
                                        <FrameworkElement.Style>
                                          <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                              <DataTrigger Value="Enum" Binding="{Binding EditorType}">
                                                <Setter Property="Visibility" Value="Visible" />
                                              </DataTrigger>
                                            </Style.Triggers>
                                          </Style>
                                        </FrameworkElement.Style>
                                      </ComboBox>
                                      <Border BorderThickness="1" BorderBrush="{DynamicResource CONCOST.Brush.Border}" CornerRadius="6" Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}" HorizontalAlignment="Left" Padding="2">
                                        <FrameworkElement.Style>
                                          <Style TargetType="{x:Type Border}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                              <DataTrigger Value="HorizontalAlignment" Binding="{Binding EditorType}">
                                                <Setter Property="Visibility" Value="Visible" />
                                              </DataTrigger>
                                            </Style.Triggers>
                                          </Style>
                                        </FrameworkElement.Style>
                                        <StackPanel Orientation="Horizontal">
                                          <RadioButton Padding="8,4" ToolTip="Left" Style="{DynamicResource CONCOST.RadioButton.Segment}" IsChecked="{Binding IsAlignLeft, Mode=TwoWay}">
                                            <icons:Icon Kind="AlignLeft" Width="14" Height="14" />
                                          </RadioButton>
                                          <RadioButton Padding="8,4" ToolTip="Center" Style="{DynamicResource CONCOST.RadioButton.Segment}" IsChecked="{Binding IsAlignCenter, Mode=TwoWay}">
                                            <icons:Icon Kind="AlignCenter" Width="14" Height="14" />
                                          </RadioButton>
                                          <RadioButton Padding="8,4" ToolTip="Right" Style="{DynamicResource CONCOST.RadioButton.Segment}" IsChecked="{Binding IsAlignRight, Mode=TwoWay}">
                                            <icons:Icon Kind="AlignRight" Width="14" Height="14" />
                                          </RadioButton>
                                          <RadioButton Padding="8,4" ToolTip="Stretch" Style="{DynamicResource CONCOST.RadioButton.Segment}" IsChecked="{Binding IsAlignStretch, Mode=TwoWay}">
                                            <icons:Icon Kind="AlignJustify" Width="14" Height="14" />
                                          </RadioButton>
                                        </StackPanel>
                                      </Border>
                                      <Border BorderThickness="1" BorderBrush="{DynamicResource CONCOST.Brush.Border}" CornerRadius="6" Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}" HorizontalAlignment="Left" Padding="2">
                                        <FrameworkElement.Style>
                                          <Style TargetType="{x:Type Border}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                              <DataTrigger Value="VerticalAlignment" Binding="{Binding EditorType}">
                                                <Setter Property="Visibility" Value="Visible" />
                                              </DataTrigger>
                                            </Style.Triggers>
                                          </Style>
                                        </FrameworkElement.Style>
                                        <StackPanel Orientation="Horizontal">
                                          <RadioButton Padding="8,4" ToolTip="Top" Style="{DynamicResource CONCOST.RadioButton.Segment}" IsChecked="{Binding IsValignTop, Mode=TwoWay}">
                                            <icons:Icon Kind="ChevronUp" Width="14" Height="14" />
                                          </RadioButton>
                                          <RadioButton Padding="8,4" ToolTip="Center" Style="{DynamicResource CONCOST.RadioButton.Segment}" IsChecked="{Binding IsValignCenter, Mode=TwoWay}">
                                            <icons:Icon Kind="Minus" Width="14" Height="14" />
                                          </RadioButton>
                                          <RadioButton Padding="8,4" ToolTip="Bottom" Style="{DynamicResource CONCOST.RadioButton.Segment}" IsChecked="{Binding IsValignBottom, Mode=TwoWay}">
                                            <icons:Icon Kind="ChevronDown" Width="14" Height="14" />
                                          </RadioButton>
                                          <RadioButton Padding="8,4" ToolTip="Stretch" Style="{DynamicResource CONCOST.RadioButton.Segment}" IsChecked="{Binding IsValignStretch, Mode=TwoWay}">
                                            <icons:Icon Kind="Menu" Width="14" Height="14" />
                                          </RadioButton>
                                        </StackPanel>
                                      </Border>
                                      <Border Width="36" Height="36" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource CONCOST.Brush.Border}" Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}" HorizontalAlignment="Left" Cursor="Hand">
                                        <FrameworkElement.Style>
                                          <Style TargetType="{x:Type Border}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                              <DataTrigger Value="ImageSource" Binding="{Binding EditorType}">
                                                <Setter Property="Visibility" Value="Visible" />
                                              </DataTrigger>
                                            </Style.Triggers>
                                          </Style>
                                        </FrameworkElement.Style>
                                        <icons:Icon Kind="Plus" Width="14" Height="14" Foreground="{DynamicResource CONCOST.Brush.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                      </Border>
                                    </Grid>
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Border>
                        </Expander>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
