  <Style x:Key="CONCOST.DrawerMenu.Base" TargetType="{x:Type controls:DrawerMenu}">
    <Setter Property="controls:DrawerMenu.CompactWidth" Value="64" />
    <Setter Property="controls:DrawerMenu.ExpandedWidth" Value="240" />
    <Setter Property="Background" Value="{DynamicResource CONCOST.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CONCOST.Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:DrawerMenu}">
          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" ClipToBounds="True" SnapsToDevicePixels="True">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Height="54" Padding="12,0" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="0,0,0,1">
                <Grid VerticalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ContentPresenter Grid.Column="0" Content="{TemplateBinding HeaderedItemsControl.Header}" VerticalAlignment="Center" Visibility="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <ToggleButton Name="PART_ToggleBtn" Grid.Column="1" Width="36" Height="36" Cursor="Hand" IsChecked="{Binding IsOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Visibility="{Binding ShowToggleButton, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Control.Template>
                      <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Name="TBtnBorder" CornerRadius="6" Background="#00FFFFFF">
                          <icons:Icon x:Name="TBtnIcon" Kind="Menu" Width="18" Height="18" Foreground="{DynamicResource CONCOST.Brush.TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="UIElement.IsMouseOver" Value="True">
                            <Setter TargetName="TBtnBorder" Value="{DynamicResource CONCOST.Brush.SurfaceSecondary}" Property="Border.Background" />
                            <Setter TargetName="TBtnIcon" Value="{DynamicResource CONCOST.Brush.Primary}" Property="Foreground" />
                          </Trigger>
                          <Trigger Property="ToggleButton.IsChecked" Value="False">
                            <Setter TargetName="TBtnIcon" Property="icons:Icon.Kind" Value="ArrowRight" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Control.Template>
                  </ToggleButton>
                </Grid>
              </Border>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,10">
                <ItemsControl ItemsSource="{TemplateBinding ItemsControl.ItemsSource}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:Key="{DataTemplateKey {x:Type controls:DrawerMenuItem}}" DataType="{x:Type controls:DrawerMenuItem}">
                      <RadioButton GroupName="DrawerMenuGroup" Cursor="Hand" Margin="0,3" Height="42" IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip="{Binding Text}">
                        <Control.Template>
                          <ControlTemplate TargetType="{x:Type RadioButton}">
                            <Border Name="ItemBorder" CornerRadius="8" Background="#00FFFFFF" Padding="12,0">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="24" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <icons:Icon x:Name="ItemIcon" Width="18" Height="18" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" VerticalAlignment="Center" Kind="{Binding Icon}" />
                                <TextBlock Name="ItemText" Grid.Column="1" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource CONCOST.Brush.TextPrimary}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" Text="{Binding Text}" Visibility="{Binding IsOpen, RelativeSource={RelativeSource AncestorType=controls:DrawerMenu}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Border Name="ItemBadge" Grid.Column="2" Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="6,1" VerticalAlignment="Center" Visibility="Collapsed">
                                  <TextBlock Name="ItemBadgeText" FontSize="10.5" FontWeight="Normal" Foreground="{DynamicResource CONCOST.Brush.Primary}" Text="{Binding Badge}" />
                                </Border>
                              </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                              <DataTrigger Value="True" Binding="{Binding HasBadge}">
                                <Setter TargetName="ItemBadge" Property="Visibility" Value="Visible" />
                              </DataTrigger>
                              <Trigger Property="UIElement.IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Value="{DynamicResource CONCOST.Brush.SurfaceSecondary}" Property="Border.Background" />
                              </Trigger>
                              <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="ItemBorder" Value="{DynamicResource CONCOST.Brush.Primary}" Property="Border.Background" />
                                <Setter TargetName="ItemIcon" Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="ItemText" Property="TextBlock.Foreground" Value="#FFFFFF" />
                                <Setter TargetName="ItemBadge" Property="Border.Background" Value="#FFFFFF" />
                                <Setter TargetName="ItemBadge" Property="Border.BorderThickness" Value="0" />
                                <Setter TargetName="ItemBadgeText" Value="{DynamicResource CONCOST.Brush.Primary}" Property="TextBlock.Foreground" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Control.Template>
                      </RadioButton>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Border Grid.Row="2" Padding="8,10" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="0,1,0,0" Visibility="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ContentPresenter Content="{TemplateBinding controls:DrawerMenu.Footer}" />
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="controls:DrawerMenu.IsOpen" Value="False">
              <Setter TargetName="PART_ToggleBtn" Property="Grid.Column" Value="0" />
              <Setter TargetName="PART_ToggleBtn" Property="Grid.ColumnSpan" Value="2" />
              <Setter TargetName="PART_ToggleBtn" Property="HorizontalAlignment" Value="Center" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type controls:DrawerMenu}" TargetType="{x:Type controls:DrawerMenu}" BasedOn="{StaticResource CONCOST.DrawerMenu.Base}" />
