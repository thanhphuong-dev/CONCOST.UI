  <Style x:Key="CONCOST.GrowlItem.Base" TargetType="{x:Type controls:GrowlItem}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Margin" Value="0,0,0,12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:GrowlItem}">
          <Border Name="mainBorder" Width="340" MinHeight="64" Background="{DynamicResource CONCOST.Brush.Surface}" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="14,12" SnapsToDevicePixels="True">
            <UIElement.Effect>
              <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.12" />
            </UIElement.Effect>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <icons:Icon x:Name="statusIcon" Grid.Row="0" Grid.Column="0" Kind="Info" Width="26" Height="26" Foreground="{DynamicResource CONCOST.Brush.Primary}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0" />
              <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Margin="2,0,8,0">
                <TextBlock Text="{TemplateBinding controls:GrowlItem.Message}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource CONCOST.Brush.TextPrimary}" TextWrapping="Wrap" LineHeight="19" />
                <TextBlock Text="{TemplateBinding controls:GrowlItem.TimeString}" FontSize="11" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" Margin="0,4,0,0" Opacity="0.8" />
              </StackPanel>
              <Button Name="PART_CloseButton" Grid.Row="0" Grid.Column="2" Width="22" Height="22" VerticalAlignment="Top" Cursor="Hand" Background="#00FFFFFF" BorderThickness="0" Style="{x:Null}">
                <Control.Template>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border Name="btnBorder" Background="#00FFFFFF" CornerRadius="4">
                      <icons:Icon Kind="Close" Width="10" Height="10" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter TargetName="btnBorder" Value="{DynamicResource CONCOST.Brush.SurfaceHover}" Property="Border.Background" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Control.Template>
              </Button>
              <UniformGrid Name="askButtonsPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Columns="2" Margin="0,12,0,0" Visibility="Collapsed">
                <Button Name="PART_CancelBtn" Content="Cancel" Margin="0,0,6,0" Height="28" FontSize="12" Style="{DynamicResource CONCOST.Button.Secondary}" />
                <Button Name="PART_ConfirmBtn" Content="Confirm" Margin="6,0,0,0" Height="28" FontSize="12" Style="{DynamicResource CONCOST.Button.Primary}" />
              </UniformGrid>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="controls:GrowlItem.GrowlType" Value="Info">
              <Setter TargetName="statusIcon" Property="icons:Icon.Kind" Value="Info" />
              <Setter TargetName="statusIcon" Value="{DynamicResource CONCOST.Brush.Primary}" Property="Foreground" />
            </Trigger>
            <Trigger Property="controls:GrowlItem.GrowlType" Value="Success">
              <Setter TargetName="statusIcon" Property="icons:Icon.Kind" Value="CheckCircle" />
              <Setter TargetName="statusIcon" Value="{DynamicResource CONCOST.Brush.Success}" Property="Foreground" />
            </Trigger>
            <Trigger Property="controls:GrowlItem.GrowlType" Value="Warning">
              <Setter TargetName="statusIcon" Property="icons:Icon.Kind" Value="Warning" />
              <Setter TargetName="statusIcon" Value="{DynamicResource CONCOST.Brush.Warning}" Property="Foreground" />
            </Trigger>
            <Trigger Property="controls:GrowlItem.GrowlType" Value="Error">
              <Setter TargetName="statusIcon" Property="icons:Icon.Kind" Value="ShieldAlert" />
              <Setter TargetName="statusIcon" Value="{DynamicResource CONCOST.Brush.Danger}" Property="Foreground" />
            </Trigger>
            <Trigger Property="controls:GrowlItem.GrowlType" Value="Fatal">
              <Setter TargetName="statusIcon" Property="icons:Icon.Kind" Value="Close" />
              <Setter TargetName="statusIcon" Property="Foreground" Value="#991B1B" />
            </Trigger>
            <Trigger Property="controls:GrowlItem.GrowlType" Value="Ask">
              <Setter TargetName="statusIcon" Property="icons:Icon.Kind" Value="Info" />
              <Setter TargetName="statusIcon" Value="{DynamicResource CONCOST.Brush.Primary}" Property="Foreground" />
              <Setter TargetName="askButtonsPanel" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
