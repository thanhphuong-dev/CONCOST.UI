  <Style x:Key="CONCOST.CardCarouselItem.Base" TargetType="{x:Type dash:CardCarouselItem}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dash:CardCarouselItem}">
          <Border Name="CardBorder" Background="{DynamicResource CONCOST.Brush.Surface}" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="16" Effect="{DynamicResource CONCOST.Shadow.Depth2}" SnapsToDevicePixels="True">
            <ContentPresenter Content="{TemplateBinding ContentControl.Content}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="dash:CardCarouselItem.IsActive" Value="True">
              <Setter TargetName="CardBorder" Value="{DynamicResource CONCOST.Brush.Primary}" Property="Border.BorderBrush" />
