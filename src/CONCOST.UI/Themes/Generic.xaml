                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Control.Template>
                </Button>
                <Button Name="PART_NextButton" HorizontalAlignment="Right" Width="42" Height="42" Cursor="Hand">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border Name="BtnBorder" Width="42" Height="42" CornerRadius="21" Background="{DynamicResource CONCOST.Brush.Surface}" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="1.5" Effect="{DynamicResource CONCOST.Shadow.Depth2}">
                        <icons:Icon x:Name="BtnIcon" Kind="ChevronRight" Width="18" Height="18" Foreground="{DynamicResource CONCOST.Brush.TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter TargetName="BtnBorder" Value="{DynamicResource CONCOST.Brush.Primary}" Property="Border.Background" />
                          <Setter TargetName="BtnBorder" Value="{DynamicResource CONCOST.Brush.Primary}" Property="Border.BorderBrush" />
                          <Setter TargetName="BtnBorder" Value="{DynamicResource CONCOST.Shadow.Depth3}" Property="UIElement.Effect" />
                          <Setter TargetName="BtnIcon" Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="ButtonBase.IsPressed" Value="True">
                          <Setter TargetName="BtnBorder" Property="RenderTransform">
                            <Setter.Value>
                              <ScaleTransform ScaleX="0.92" ScaleY="0.92" CenterX="21" CenterY="21" />
                            </Setter.Value>
                          </Setter>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Control.Template>
                </Button>
              </Grid>
            </Grid>
          </Border>
        </ControlTemplate>
