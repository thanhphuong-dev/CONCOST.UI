                  <DoubleAnimation Storyboard.TargetName="Dot4" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-10" Duration="0:0:0.35" AutoReverse="True" BeginTime="0:0:0.27" />
