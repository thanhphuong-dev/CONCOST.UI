                              <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="ItemBorder" Value="{DynamicResource CONCOST.Brush.Primary}" Property="Border.Background" />
                                <Setter TargetName="ItemIcon" Property="Foreground" Value="#FFFFFF" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Control.Template>
                      </RadioButton>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <ContentPresenter Grid.Row="2" Content="{TemplateBinding controls:SideMenu.Footer}" Margin="0,8,0,0" HorizontalAlignment="Center" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CONCOST.SideMenu.Filled" TargetType="{x:Type controls:SideMenu}" BasedOn="{StaticResource CONCOST.SideMenu.Base}">
    <Setter Property="Background" Value="{DynamicResource CONCOST.Brush.SurfaceSecondary}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style x:Key="{x:Type controls:SideMenu}" TargetType="{x:Type controls:SideMenu}" BasedOn="{StaticResource CONCOST.SideMenu.Base}" />
  <Style x:Key="CONCOST.TimelineItem.Base" TargetType="{x:Type dash:TimelineItem}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Foreground" Value="{DynamicResource CONCOST.Brush.TextPrimary}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type dash:TimelineItem}">
          <Grid SnapsToDevicePixels="True" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="32" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{TemplateBinding dash:TimelineItem.Time}" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" FontSize="12" FontWeight="Normal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,16,0" />
            <Grid Column="1" HorizontalAlignment="Center">
              <Rectangle Name="TrackLine" Width="2" Fill="{DynamicResource CONCOST.Brush.Border}" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,16,0,-24" />
              <Border Name="DotNode" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource CONCOST.Brush.Surface}" BorderBrush="{DynamicResource CONCOST.Brush.Primary}" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Top" Effect="{DynamicResource CONCOST.Shadow.Depth1}">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Ellipse Name="InnerCore" Width="8" Height="8" Fill="{DynamicResource CONCOST.Brush.Primary}" />
                  <icons:Icon x:Name="NodeIcon" Kind="{TemplateBinding dash:TimelineItem.Icon}" Width="11" Height="11" Foreground="{DynamicResource CONCOST.Brush.Primary}" Visibility="Collapsed" />
                </Grid>
              </Border>
            </Grid>
            <StackPanel Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Top">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextBlock.FontWeight="Normal" TextBlock.FontSize="13.5" TextBlock.Foreground="{TemplateBinding Control.Foreground}" />
              <TextBlock Name="DescText" Text="{TemplateBinding dash:TimelineItem.Description}" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18" Visibility="Collapsed" />
              <ContentPresenter Margin="0,6,0,0" />
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="dash:TimelineItem.IsLast" Value="True">
              <Setter TargetName="TrackLine" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="dash:TimelineItem.Description" Value="">
              <Setter TargetName="DescText" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <DataTrigger Binding="{Binding Description, RelativeSource={RelativeSource Self}, Converter={x:Null}}" Value="{x:Null}">
              <Setter TargetName="DescText" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <Trigger Property="dash:TimelineItem.Icon" Value="None">
              <Setter TargetName="InnerCore" Property="Visibility" Value="Visible" />
              <Setter TargetName="NodeIcon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="dash:TimelineItem.DotBrush" Value="{x:Null}" />
            <Trigger Property="dash:TimelineItem.Type" Value="Primary">
              <Setter TargetName="DotNode" Value="{DynamicResource CONCOST.Brush.Primary}" Property="Border.BorderBrush" />
              <Setter TargetName="InnerCore" Value="{DynamicResource CONCOST.Brush.Primary}" Property="Shape.Fill" />
              <Setter TargetName="NodeIcon" Value="{DynamicResource CONCOST.Brush.Primary}" Property="Foreground" />
            </Trigger>
            <Trigger Property="dash:TimelineItem.Type" Value="Success">
              <Setter TargetName="DotNode" Value="{DynamicResource CONCOST.Brush.Success}" Property="Border.BorderBrush" />
              <Setter TargetName="InnerCore" Value="{DynamicResource CONCOST.Brush.Success}" Property="Shape.Fill" />
              <Setter TargetName="NodeIcon" Value="{DynamicResource CONCOST.Brush.Success}" Property="Foreground" />
            </Trigger>
            <Trigger Property="dash:TimelineItem.Type" Value="Warning">
              <Setter TargetName="DotNode" Value="{DynamicResource CONCOST.Brush.Warning}" Property="Border.BorderBrush" />
              <Setter TargetName="InnerCore" Value="{DynamicResource CONCOST.Brush.Warning}" Property="Shape.Fill" />
              <Setter TargetName="NodeIcon" Value="{DynamicResource CONCOST.Brush.Warning}" Property="Foreground" />
            </Trigger>
            <Trigger Property="dash:TimelineItem.Type" Value="Danger">
              <Setter TargetName="DotNode" Value="{DynamicResource CONCOST.Brush.Danger}" Property="Border.BorderBrush" />
              <Setter TargetName="InnerCore" Value="{DynamicResource CONCOST.Brush.Danger}" Property="Shape.Fill" />
              <Setter TargetName="NodeIcon" Value="{DynamicResource CONCOST.Brush.Danger}" Property="Foreground" />
            </Trigger>
            <Trigger Property="dash:TimelineItem.Type" Value="Info">
              <Setter TargetName="DotNode" Value="{DynamicResource CONCOST.Brush.Info}" Property="Border.BorderBrush" />
              <Setter TargetName="InnerCore" Value="{DynamicResource CONCOST.Brush.Info}" Property="Shape.Fill" />
              <Setter TargetName="NodeIcon" Value="{DynamicResource CONCOST.Brush.Info}" Property="Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type dash:TimelineItem}" TargetType="{x:Type dash:TimelineItem}" BasedOn="{StaticResource CONCOST.TimelineItem.Base}" />
