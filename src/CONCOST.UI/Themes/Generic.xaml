  <ControlTemplate x:Key="CONCOST.Slider.Thumb" TargetType="{x:Type Thumb}">
    <Grid Width="20" Height="20" Background="#00FFFFFF">
      <Border Name="BorderDot" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource CONCOST.Brush.Surface}" BorderBrush="{DynamicResource CONCOST.Brush.Primary}" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
        <UIElement.Effect>
          <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25" Direction="270" />
        </UIElement.Effect>
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter TargetName="BorderDot" Property="Border.BorderThickness" Value="3" />
        <Setter TargetName="BorderDot" Property="FrameworkElement.Width" Value="18" />
        <Setter TargetName="BorderDot" Property="FrameworkElement.Height" Value="18" />
        <Setter TargetName="BorderDot" Property="Border.CornerRadius" Value="9" />
      </Trigger>
      <Trigger Property="Thumb.IsDragging" Value="True">
        <Setter TargetName="BorderDot" Value="{DynamicResource CONCOST.Brush.Primary}" Property="Border.Background" />
        <Setter TargetName="BorderDot" Property="Border.BorderThickness" Value="3" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="CONCOST.Slider.Base" TargetType="{x:Type Slider}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
    <Setter Property="Background" Value="{DynamicResource CONCOST.Brush.SurfaceSecondary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CONCOST.Brush.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource CONCOST.Brush.TextSecondary}" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Slider}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" MinHeight="{TemplateBinding FrameworkElement.MinHeight}" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TickBar Name="TopTick" Fill="{TemplateBinding Control.Foreground}" Height="4" Margin="0,0,0,2" Placement="Top" Grid.Row="0" Visibility="Collapsed" />
            <TickBar Name="BottomTick" Fill="{TemplateBinding Control.Foreground}" Height="4" Margin="0,2,0,0" Placement="Bottom" Grid.Row="2" Visibility="Collapsed" />
            <Border Name="TrackBackground" Background="{DynamicResource CONCOST.Brush.Border}" Grid.Row="1" Height="4" CornerRadius="2" VerticalAlignment="Center" Margin="10,0" />
            <Track Name="PART_Track" Grid.Row="1">
              <Track.DecreaseRepeatButton>
                <RepeatButton Margin="10,0,0,0" Command="{x:Static Slider.DecreaseLarge}" Background="{DynamicResource CONCOST.Brush.Primary}" Style="{StaticResource CONCOST.Slider.RepeatButton.Horizontal}" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Margin="0,0,10,0" Command="{x:Static Slider.IncreaseLarge}" Background="{DynamicResource CONCOST.Brush.Border}" Style="{StaticResource CONCOST.Slider.RepeatButton.Horizontal}" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Name="Thumb" OverridesDefaultStyle="True" VerticalAlignment="Center" Template="{StaticResource CONCOST.Slider.Thumb}" />
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Slider.TickPlacement" Value="TopLeft">
              <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Slider.TickPlacement" Value="BottomRight">
              <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="Slider.TickPlacement" Value="Both">
              <Setter TargetName="TopTick" Property="Visibility" Value="Visible" />
              <Setter TargetName="BottomTick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Slider.Orientation" Value="Vertical">
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="100" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Slider}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" MinWidth="{TemplateBinding FrameworkElement.MinWidth}" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TickBar Name="LeftTick" Fill="{TemplateBinding Control.Foreground}" Width="4" Margin="0,0,2,0" Placement="Left" Grid.Column="0" Visibility="Collapsed" />
                <TickBar Name="RightTick" Fill="{TemplateBinding Control.Foreground}" Width="4" Margin="2,0,0,0" Placement="Right" Grid.Column="2" Visibility="Collapsed" />
                <Border Name="TrackBackground" Background="{DynamicResource CONCOST.Brush.Border}" Grid.Column="1" Width="4" CornerRadius="2" HorizontalAlignment="Center" Margin="0,10" />
                <Track Name="PART_Track" Grid.Column="1">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Margin="0,0,0,10" Command="{x:Static Slider.DecreaseLarge}" Background="{DynamicResource CONCOST.Brush.Primary}" Style="{StaticResource CONCOST.Slider.RepeatButton.Vertical}" />
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Margin="0,10,0,0" Command="{x:Static Slider.IncreaseLarge}" Background="{DynamicResource CONCOST.Brush.Border}" Style="{StaticResource CONCOST.Slider.RepeatButton.Vertical}" />
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Name="Thumb" OverridesDefaultStyle="True" HorizontalAlignment="Center" Template="{StaticResource CONCOST.Slider.Thumb}" />
                  </Track.Thumb>
                </Track>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="Slider.TickPlacement" Value="TopLeft">
                  <Setter TargetName="LeftTick" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="Slider.TickPlacement" Value="BottomRight">
                  <Setter TargetName="RightTick" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="Slider.TickPlacement" Value="Both">
                  <Setter TargetName="LeftTick" Property="Visibility" Value="Visible" />
