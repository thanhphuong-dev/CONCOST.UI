  <Style x:Key="CONCOST.SideMenu.Base" TargetType="{x:Type controls:SideMenu}">
    <Setter Property="Width" Value="240" />
    <Setter Property="Background" Value="{DynamicResource CONCOST.Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CONCOST.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:SideMenu}">
          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="10" Padding="8" SnapsToDevicePixels="True">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <ContentPresenter Grid.Row="0" Content="{TemplateBinding controls:SideMenu.Header}" Margin="0,0,0,10" />
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{TemplateBinding controls:SideMenu.Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:Key="{DataTemplateKey {x:Type controls:SideMenuItem}}" DataType="{x:Type controls:SideMenuItem}">
                      <RadioButton GroupName="SideMenuGroup" Cursor="Hand" Margin="0,2" Height="38" IsChecked="{Binding IsSelected, Mode=TwoWay}">
                        <Control.Template>
                          <ControlTemplate TargetType="{x:Type RadioButton}">
                            <Border Name="ItemBorder" CornerRadius="6" Background="#00FFFFFF" Padding="12,0">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="22" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <icons:Icon x:Name="ItemIcon" Width="16" Height="16" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" VerticalAlignment="Center" Kind="{Binding Icon}" />
                                <TextBlock Name="ItemTitle" Grid.Column="1" FontSize="12.5" FontWeight="Normal" Foreground="{DynamicResource CONCOST.Brush.TextPrimary}" VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding Title}" />
                                <Border Name="ItemBadge" Grid.Column="2" Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="6,1" VerticalAlignment="Center" Visibility="Collapsed">
                                  <TextBlock Name="ItemBadgeText" FontSize="10.5" FontWeight="Normal" Foreground="{DynamicResource CONCOST.Brush.Primary}" Text="{Binding Badge}" />
                                </Border>
                              </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                              <DataTrigger Value="True" Binding="{Binding HasBadge}">
                                <Setter TargetName="ItemBadge" Property="Visibility" Value="Visible" />
                              </DataTrigger>
                              <Trigger Property="UIElement.IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Value="{DynamicResource CONCOST.Brush.SurfaceSecondary}" Property="Border.Background" />
                              </Trigger>
                              <Trigger Property="ToggleButton.IsChecked" Value="True">
                                <Setter TargetName="ItemBorder" Value="{DynamicResource CONCOST.Brush.Primary}" Property="Border.Background" />
                                <Setter TargetName="ItemIcon" Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="ItemTitle" Property="TextBlock.Foreground" Value="#FFFFFF" />
                                <Setter TargetName="ItemBadge" Property="Border.Background" Value="#FFFFFF" />
                                <Setter TargetName="ItemBadge" Property="Border.BorderThickness" Value="0" />
                                <Setter TargetName="ItemBadgeText" Value="{DynamicResource CONCOST.Brush.Primary}" Property="TextBlock.Foreground" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Control.Template>
                      </RadioButton>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <ContentPresenter Grid.Row="2" Content="{TemplateBinding controls:SideMenu.Footer}" Margin="0,10,0,0" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CONCOST.SideMenu.Rail" TargetType="{x:Type controls:SideMenu}">
