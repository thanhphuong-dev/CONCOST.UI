            <Ellipse Name="Dot5" Width="{TemplateBinding controls:LoadingLine.DotSize}" Height="{TemplateBinding controls:LoadingLine.DotSize}" Fill="{TemplateBinding Control.Foreground}" Margin="3,0" RenderTransformOrigin="0.5,0.5">
              <UIElement.RenderTransform>
                <TranslateTransform Y="0" />
              </UIElement.RenderTransform>
            </Ellipse>
          </StackPanel>
          <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-10" Duration="0:0:0.35" AutoReverse="True" BeginTime="0:0:0.00" />
                  <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-10" Duration="0:0:0.35" AutoReverse="True" BeginTime="0:0:0.09" />
