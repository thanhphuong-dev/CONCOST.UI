                </ControlTemplate>
              </Control.Template>
            </Thumb>
            <Thumb Name="PART_EndThumb" Width="18" Height="18" HorizontalAlignment="Left" Cursor="Hand">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type Thumb}">
                  <Border Name="ThumbBorder" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource CONCOST.Brush.Surface}" BorderBrush="{DynamicResource CONCOST.Brush.Primary}" BorderThickness="2.5" Effect="{DynamicResource CONCOST.Shadow.Depth2}" />
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter TargetName="ThumbBorder" Value="{DynamicResource CONCOST.Brush.Primary}" Property="Border.Background" />
                      <Setter TargetName="ThumbBorder" Property="Border.BorderBrush" Value="#FFFFFF" />
                      <Setter TargetName="ThumbBorder" Property="Border.BorderThickness" Value="2" />
                    </Trigger>
                    <Trigger Property="Thumb.IsDragging" Value="True">
                      <Setter TargetName="ThumbBorder" Value="{DynamicResource CONCOST.Brush.Primary}" Property="Border.Background" />
                      <Setter TargetName="ThumbBorder" Property="Border.BorderBrush" Value="#FFFFFF" />
                      <Setter TargetName="ThumbBorder" Property="Border.BorderThickness" Value="2" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Control.Template>
            </Thumb>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type controls:RangeSlider}" TargetType="{x:Type controls:RangeSlider}" BasedOn="{StaticResource CONCOST.RangeSlider.Base}" />
  <Style x:Key="CONCOST.AutoCompleteTextBox.Base" TargetType="{x:Type controls:AutoCompleteTextBox}">
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource CONCOST.Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource CONCOST.Brush.TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CONCOST.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="TextBoxBase.CaretBrush" Value="{DynamicResource CONCOST.Brush.Primary}" />
    <Setter Property="attached:BorderElement.CornerRadius" Value="6" />
    <Setter Property="attached:InfoElement.ShowClearButton" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:AutoCompleteTextBox}">
          <Grid SnapsToDevicePixels="True">
            <Border Name="RootBorder" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}" CornerRadius="{Binding Path=(attached:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <icons:Icon x:Name="PART_PrefixIcon" Grid.Column="0" Kind="{TemplateBinding attached:IconElement.Kind}" Width="14" Height="14" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type icons:Icon}">
                      <Style.Triggers>
                        <DataTrigger Value="None" Binding="{Binding Path=(attached:IconElement.Kind), RelativeSource={RelativeSource AncestorType=TextBox}}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </icons:Icon>
                <Grid Column="1" VerticalAlignment="Center">
                  <ScrollViewer Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center" />
                  <TextBlock Name="placeholder" Text="{TemplateBinding attached:InfoElement.Placeholder}" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" Opacity="0.45" IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0" Visibility="Collapsed" />
                </Grid>
                <Button Name="PART_ClearButton" Grid.Column="2" Cursor="Hand" Width="18" Height="18" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border Background="#00FFFFFF" Width="18" Height="18">
                        <icons:Icon Kind="Close" Width="11" Height="11" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter Property="UIElement.Opacity" Value="1.0" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Control.Template>
                </Button>
              </Grid>
            </Border>
            <Popup Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide" PlacementTarget="{Binding ElementName=RootBorder}" IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <Border MaxHeight="{TemplateBinding controls:AutoCompleteTextBox.MaxDropDownHeight}" Background="{DynamicResource CONCOST.Brush.Surface}" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0" Padding="4" Effect="{DynamicResource CONCOST.Shadow.Depth3}" Width="{Binding ActualWidth, ElementName=RootBorder}">
                <ListBox Name="PART_ListBox" Background="#00FFFFFF" BorderThickness="0" ItemTemplate="{TemplateBinding controls:AutoCompleteTextBox.ItemTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                  <ItemsControl.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                      <Setter Property="Padding" Value="10,8" />
                      <Setter Property="Margin" Value="0,1" />
                      <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                      <Setter Property="FontWeight" Value="Normal" />
                      <Setter Property="Background" Value="#00FFFFFF" />
                      <Setter Property="Foreground" Value="{DynamicResource CONCOST.Brush.TextPrimary}" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border Name="ItemBorder" Background="{TemplateBinding Control.Background}" CornerRadius="6" Padding="{TemplateBinding Control.Padding}">
                              <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="UIElement.IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Value="{DynamicResource CONCOST.Brush.SurfaceSecondary}" Property="Border.Background" />
                              </Trigger>
                              <Trigger Property="ListBoxItem.IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Value="{DynamicResource CONCOST.Brush.PrimaryLight}" Property="Border.Background" />
                                <Setter Value="{DynamicResource CONCOST.Brush.Primary}" Property="Foreground" />
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ItemsControl.ItemContainerStyle>
                </ListBox>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Value="" Binding="{Binding Path=Text, RelativeSource={RelativeSource Self}}">
              <Setter TargetName="placeholder" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="UIElement.IsMouseOver" Value="True" />
                <Condition Property="attached:InfoElement.ShowClearButton" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="UIElement.IsKeyboardFocused" Value="True" />
                <Condition Property="attached:InfoElement.ShowClearButton" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <Trigger Property="Text" Value="">
              <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="RootBorder" Value="{DynamicResource CONCOST.Brush.BorderHover}" Property="Border.BorderBrush" />
            </Trigger>
            <Trigger Property="UIElement.IsFocused" Value="True">
              <Setter TargetName="RootBorder" Value="{DynamicResource CONCOST.Brush.Primary}" Property="Border.BorderBrush" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type controls:AutoCompleteTextBox}" TargetType="{x:Type controls:AutoCompleteTextBox}" BasedOn="{StaticResource CONCOST.AutoCompleteTextBox.Base}" />
  <Style x:Key="CONCOST.Spreadsheet.Base" TargetType="{x:Type controls:Spreadsheet}">
    <Setter Property="Background" Value="{DynamicResource CONCOST.Brush.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource CONCOST.Brush.TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CONCOST.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="controls:Spreadsheet.HeaderBackground" Value="{DynamicResource CONCOST.Brush.SurfaceSecondary}" />
    <Setter Property="controls:Spreadsheet.GridLineBrush" Value="{DynamicResource CONCOST.Brush.Border}" />
    <Setter Property="controls:Spreadsheet.SelectionBorderBrush" Value="{DynamicResource CONCOST.Brush.Primary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:Spreadsheet}">
          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="8" ClipToBounds="True">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="0,0,0,1" Padding="6,4" Visibility="{Binding ShowToolbar, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="True" Focusable="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Button attached:IconElement.Kind="Undo" ToolTip="Undo (Ctrl+Z)" Padding="6,4" Margin="0,0,2,0" Style="{StaticResource CONCOST.Button.Secondary}" Command="{Binding UndoCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Button attached:IconElement.Kind="Redo" ToolTip="Redo (Ctrl+Y)" Padding="6,4" Margin="0,0,6,0" Style="{StaticResource CONCOST.Button.Secondary}" Command="{Binding RedoCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Rectangle Width="1" Fill="{DynamicResource CONCOST.Brush.Border}" Margin="4,2" />
                  <Button attached:IconElement.Kind="Copy" ToolTip="Copy (Ctrl+C)" Padding="6,4" Margin="0,0,2,0" Style="{StaticResource CONCOST.Button.Secondary}" Command="{Binding CopyCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Button attached:IconElement.Kind="Paste" ToolTip="Paste (Ctrl+V)" Padding="6,4" Margin="0,0,2,0" Style="{StaticResource CONCOST.Button.Secondary}" Command="{Binding PasteCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Button attached:IconElement.Kind="Cut" ToolTip="Cut (Ctrl+X)" Padding="6,4" Margin="0,0,6,0" Style="{StaticResource CONCOST.Button.Secondary}" Command="{Binding CutCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Rectangle Width="1" Fill="{DynamicResource CONCOST.Brush.Border}" Margin="4,2" />
                  <Button FontWeight="Normal" Content="B" Width="28" Height="26" ToolTip="Bold (Ctrl+B)" Margin="2,0" Style="{StaticResource CONCOST.Button.Secondary}" Command="{Binding ToggleBoldCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Button FontStyle="Italic" Content="I" Width="28" Height="26" ToolTip="Italic (Ctrl+I)" Margin="2,0" Style="{StaticResource CONCOST.Button.Secondary}" Command="{Binding ToggleItalicCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Button Content="U" Width="28" Height="26" ToolTip="Underline (Ctrl+U)" Margin="2,0" Style="{StaticResource CONCOST.Button.Secondary}" Command="{Binding ToggleUnderlineCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Rectangle Width="1" Fill="{DynamicResource CONCOST.Brush.Border}" Margin="4,2" />
                  <Button CommandParameter="Left" attached:IconElement.Kind="AlignLeft" ToolTip="Align Left" Padding="6,4" Margin="2,0" Style="{StaticResource CONCOST.Button.Secondary}" Command="{Binding SetAlignmentCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Button CommandParameter="Center" attached:IconElement.Kind="AlignCenter" ToolTip="Align Center" Padding="6,4" Margin="2,0" Style="{StaticResource CONCOST.Button.Secondary}" Command="{Binding SetAlignmentCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Button CommandParameter="Right" attached:IconElement.Kind="AlignRight" ToolTip="Align Right" Padding="6,4" Margin="2,0" Style="{StaticResource CONCOST.Button.Secondary}" Command="{Binding SetAlignmentCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Button attached:IconElement.Kind="TableMerge" ToolTip="Merge &amp; Center (Ctrl+M)" Padding="6,4" Margin="2,0" Style="{StaticResource CONCOST.Button.Secondary}" Command="{Binding MergeCellsCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Button attached:IconElement.Kind="TableSplit" ToolTip="Unmerge Cells" Padding="6,4" Margin="2,0" Style="{StaticResource CONCOST.Button.Secondary}" Command="{Binding UnmergeCellsCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Rectangle Width="1" Fill="{DynamicResource CONCOST.Brush.Border}" Margin="4,2" />
                  <Button CommandParameter="Currency" Content="$" FontWeight="Normal" Width="28" Height="26" ToolTip="Currency Format" Margin="2,0" Style="{StaticResource CONCOST.Button.Secondary}" Command="{Binding SetFormatCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Button CommandParameter="Percentage" Content="%" FontWeight="Normal" Width="28" Height="26" ToolTip="Percent Format" Margin="2,0" Style="{StaticResource CONCOST.Button.Secondary}" Command="{Binding SetFormatCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Button CommandParameter="Number" Content=",00" FontSize="10" FontWeight="Normal" Height="26" Padding="6,2" ToolTip="Number Format (,00)" Margin="2,0" Style="{StaticResource CONCOST.Button.Secondary}" Command="{Binding SetFormatCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Rectangle Width="1" Fill="{DynamicResource CONCOST.Brush.Border}" Margin="4,2" />
                  <Button attached:IconElement.Kind="TableRowAdd" ToolTip="Insert Row Below" Padding="6,4" Margin="2,0" Style="{StaticResource CONCOST.Button.Secondary}" Command="{Binding InsertRowCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Button attached:IconElement.Kind="TableColumnAdd" ToolTip="Insert Column Right" Padding="6,4" Margin="2,0" Style="{StaticResource CONCOST.Button.Secondary}" Command="{Binding InsertColumnCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Rectangle Width="1" Fill="{DynamicResource CONCOST.Brush.Border}" Margin="4,2" />
                  <Button Content="∑ AutoSum" FontWeight="Normal" Height="26" Padding="8,2" ToolTip="AutoSum Selected Column Range" Margin="2,0" Style="{StaticResource CONCOST.Button.Secondary}" Command="{Binding AutoSumCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Button attached:IconElement.Kind="TrashCan" ToolTip="Clear Cell Contents (Del)" Padding="6,4" Margin="2,0" Style="{StaticResource CONCOST.Button.Secondary}" Command="{Binding ClearSelectionCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Rectangle Width="1" Fill="{DynamicResource CONCOST.Brush.Border}" Margin="4,2" />
                  <Button attached:IconElement.Kind="ExportFile" ToolTip="Export Sheet to CSV" Padding="6,4" Margin="2,0" Style="{StaticResource CONCOST.Button.Secondary}" Command="{Binding ExportCsvCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                  <Button attached:IconElement.Kind="ImportFile" ToolTip="Import Sheet from CSV" Padding="6,4" Margin="2,0" Style="{StaticResource CONCOST.Button.Secondary}" Command="{Binding ImportCsvCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                </StackPanel>
                </ScrollViewer>
              </Border>
              <Border Grid.Row="1" Background="{DynamicResource CONCOST.Brush.Surface}" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="0,0,0,1" Padding="6,3" Visibility="{Binding ShowFormulaBar, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="1" CornerRadius="3" Padding="4,2">
                    <TextBlock Name="PART_CellAddress" Text="A1" FontWeight="Normal" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource CONCOST.Brush.TextPrimary}" />
                  </Border>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0">
                    <Button Name="PART_FormulaCancel" Width="22" Height="22" ToolTip="Cancel Edit (Esc)" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Foreground="{DynamicResource CONCOST.Brush.Danger}" FontWeight="Normal" FontSize="11" Content="✕" Style="{x:Null}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Border Name="bd" Background="#00FFFFFF" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                              <Setter TargetName="bd" Property="Border.Background" Value="{DynamicResource CONCOST.Brush.SurfaceHover}" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Control.Template>
                    </Button>
                    <Button Name="PART_FormulaCommit" Width="22" Height="22" ToolTip="Enter / Commit (Enter)" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Foreground="{DynamicResource CONCOST.Brush.Primary}" FontWeight="Normal" FontSize="13" Content="✓" Style="{x:Null}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Border Name="bd" Background="#00FFFFFF" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                              <Setter TargetName="bd" Value="{DynamicResource CONCOST.Brush.PrimaryTint}" Property="Border.Background" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Control.Template>
                    </Button>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="fx" FontWeight="Normal" FontStyle="Italic" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" />
                  <TextBox Name="PART_FormulaTextBox" Grid.Column="3" Padding="8,4" FontSize="12" FontFamily="Segoe UI, Inter, Arial" Background="{DynamicResource CONCOST.Brush.InputBackground}" Foreground="{DynamicResource CONCOST.Brush.TextPrimary}" BorderThickness="0" VerticalContentAlignment="Center" ToolTip="Formula Bar — enter text or formula (e.g. =SUM(A1:B10))" />
                </Grid>
              </Border>
              <ScrollViewer Name="PART_ScrollViewer" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                <Grid Name="PART_ViewportGrid">
                  <controls:SpreadsheetGridPresenter x:Name="PART_GridPresenter" HorizontalAlignment="Left" VerticalAlignment="Top" />
                  <Canvas Name="PART_EditorCanvas" IsHitTestVisible="False">
                    <TextBox Name="PART_InPlaceEditor" Visibility="Collapsed" Padding="4,0,4,0" FontSize="11" FontFamily="Segoe UI, Inter, Arial" Background="{DynamicResource CONCOST.Brush.InputBackground}" Foreground="{DynamicResource CONCOST.Brush.TextPrimary}" BorderThickness="2" SelectionOpacity="0.2" VerticalContentAlignment="Center" Panel.ZIndex="10" BorderBrush="{Binding SelectionBorderBrush, RelativeSource={RelativeSource TemplatedParent}}" CaretBrush="{Binding SelectionBorderBrush, RelativeSource={RelativeSource TemplatedParent}}" SelectionBrush="{Binding SelectionBorderBrush, RelativeSource={RelativeSource TemplatedParent}}" Style="{x:Null}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                          <Border Name="border" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="0" SnapsToDevicePixels="True">
                            <ScrollViewer Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Margin="{TemplateBinding Control.Padding}" VerticalAlignment="Center" />
                          </Border>
                        </ControlTemplate>
                      </Control.Template>
                    </TextBox>
                  </Canvas>
                </Grid>
              </ScrollViewer>
              <Border Grid.Row="3" Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="0,1,0,1" Padding="6,3" Visibility="{Binding ShowSheetTabs, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <ListBox Name="PART_SheetsListBox" Background="#00FFFFFF" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{Binding Sheets, RelativeSource={RelativeSource TemplatedParent}}" SelectedItem="{Binding ActiveSheet, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock FontSize="12" Padding="12,4" Text="{Binding Name}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemContainerStyle>
                      <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                        <Setter Property="Margin" Value="0,0,4,0" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                              <Border Name="tabBorder" Background="#00FFFFFF" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="1,1,1,0" CornerRadius="3,3,0,0" Padding="2,0">
                                <Grid>
                                  <ContentPresenter Margin="8,4,8,6" />
                                  <Rectangle Name="tabIndicator" Height="2.5" VerticalAlignment="Bottom" Fill="{DynamicResource CONCOST.Brush.Primary}" Visibility="Collapsed" />
                                </Grid>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="tabBorder" Value="{DynamicResource CONCOST.Brush.Surface}" Property="Border.Background" />
                                </Trigger>
                                <Trigger Property="ListBoxItem.IsSelected" Value="True">
                                  <Setter TargetName="tabBorder" Value="{DynamicResource CONCOST.Brush.Surface}" Property="Border.Background" />
                                  <Setter TargetName="tabBorder" Value="{DynamicResource CONCOST.Brush.Border}" Property="Border.BorderBrush" />
                                  <Setter TargetName="tabIndicator" Property="Visibility" Value="Visible" />
                                  <Setter Property="FontWeight" Value="Normal" />
                                  <Setter Property="Foreground" Value="{DynamicResource CONCOST.Brush.Primary}" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ItemsControl.ItemContainerStyle>
                  </ListBox>
                  <Button Content="+" FontWeight="Normal" FontSize="14" Width="24" Height="24" Padding="0" ToolTip="Add New Sheet" Margin="4,0" Style="{StaticResource CONCOST.Button.Secondary}" Command="{Binding AddSheetCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                </StackPanel>
              </Border>
              <Border Grid.Row="4" Background="{DynamicResource CONCOST.Brush.Surface}" Padding="10,4" Visibility="{Binding ShowStatusBar, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                  <TextBlock Name="PART_SelectionStats" Text="Ready" FontSize="11" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type controls:Spreadsheet}" TargetType="{x:Type controls:Spreadsheet}" BasedOn="{StaticResource CONCOST.Spreadsheet.Base}" />
  <Style x:Key="CONCOST.Ripple.Base" TargetType="{x:Type controls:Ripple}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:Ripple}">
          <Border Name="PART_Container" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="{TemplateBinding controls:Ripple.CornerRadius}">
            <Grid ClipToBounds="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Content="{TemplateBinding ContentControl.Content}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" />
              <Canvas Name="PART_Canvas" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type controls:Ripple}" TargetType="{x:Type controls:Ripple}" BasedOn="{StaticResource CONCOST.Ripple.Base}" />
  <Style x:Key="CONCOST.Skeleton.Base" TargetType="{x:Type controls:Skeleton}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="controls:Skeleton.CornerRadius" Value="6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:Skeleton}">
          <Grid Name="PART_Root" ClipToBounds="True">
            <ContentPresenter Name="PART_ContentPresenter" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Content="{TemplateBinding ContentControl.Content}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" />
            <Border Name="PART_SkeletonHost" CornerRadius="{TemplateBinding controls:Skeleton.CornerRadius}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
