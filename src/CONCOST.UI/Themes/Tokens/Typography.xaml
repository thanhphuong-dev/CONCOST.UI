<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Font Sizes -->
    <sys:Double x:Key="CONCOST.FontSize.XS">10</sys:Double>
    <sys:Double x:Key="CONCOST.FontSize.Small">12</sys:Double>
    <sys:Double x:Key="CONCOST.FontSize.Default">14</sys:Double>
    <sys:Double x:Key="CONCOST.FontSize.Medium">15</sys:Double>
    <sys:Double x:Key="CONCOST.FontSize.Large">16</sys:Double>
    <sys:Double x:Key="CONCOST.FontSize.Title">20</sys:Double>
    <sys:Double x:Key="CONCOST.FontSize.Heading">24</sys:Double>
    <sys:Double x:Key="CONCOST.FontSize.Display">28</sys:Double>

    <!-- Font Weights -->
    <FontWeight x:Key="CONCOST.FontWeight.Regular">Normal</FontWeight>
    <FontWeight x:Key="CONCOST.FontWeight.Medium">Medium</FontWeight>
    <FontWeight x:Key="CONCOST.FontWeight.SemiBold">SemiBold</FontWeight>
    <FontWeight x:Key="CONCOST.FontWeight.Bold">Bold</FontWeight>

    <!-- Font Family -->
    <FontFamily x:Key="CONCOST.FontFamily.Default">Segoe UI, Helvetica Neue, Arial, sans-serif</FontFamily>
    <FontFamily x:Key="CONCOST.FontFamily.Monospace">Consolas, Cascadia Code, Courier New, monospace</FontFamily>

</ResourceDictionary>
