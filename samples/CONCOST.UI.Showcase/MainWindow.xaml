<Window x:Class="CONCOST.UI.Showcase.MainWindow"
        Icon="Assets/AppIcon.png"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CONCOST.UI.Showcase"
        xmlns:ui="clr-namespace:CONCOST.UI.Controls;assembly=CONCOST.UI"
        xmlns:icons="clr-namespace:CONCOST.UI.Icons;assembly=CONCOST.UI"
        xmlns:attached="clr-namespace:CONCOST.UI.AttachedProperties;assembly=CONCOST.UI"
        xmlns:services="clr-namespace:CONCOST.UI.Services;assembly=CONCOST.UI"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static services:LocalizationManager.Current}, Path=[Showcase.WindowTitle]}" Height="960" Width="1540"
        MinHeight="720" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Inter, Roboto, Arial"
        Background="{DynamicResource CONCOST.Brush.Background}"
        Foreground="{DynamicResource CONCOST.Brush.TextPrimary}">

    <Window.DataContext>
        <local:ShowcaseViewModel />
    </Window.DataContext>
    <Window.Resources>
        <local:SelectedCategoryConverter x:Key="SelectedCategoryConverter" />
        <Style x:Key="Showcase.OverviewCardButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource CONCOST.Brush.SurfaceSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CONCOST.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CardChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardChrome" Property="Background" Value="{DynamicResource CONCOST.Brush.SurfaceHover}" />
                                <Setter TargetName="CardChrome" Property="BorderBrush" Value="{DynamicResource CONCOST.Brush.BorderHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardChrome" Property="Background" Value="{DynamicResource CONCOST.Brush.SurfacePressed}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CardChrome" Property="BorderBrush" Value="{DynamicResource CONCOST.Brush.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP BAR (Sleek Header Bar with Glass Effect) -->
        <Border Grid.Row="0"
                Background="{DynamicResource CONCOST.Brush.Surface}"
                BorderBrush="{DynamicResource CONCOST.Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Meta -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/AppIcon.png" Width="42" Height="42" Margin="0,0,11,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" ToolTip="CONCOST.UI component library" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CONCOST" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource CONCOST.Brush.TextPrimary}"/>
                            <TextBlock Text=".UI" FontSize="19" FontWeight="Normal" Foreground="{DynamicResource CONCOST.Brush.Primary}"/>
                            <Border Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}" CornerRadius="5" Padding="7,2" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.0.1" FontSize="10" FontWeight="Normal" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Current}, Path=[Showcase.Brand.Caption]}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center Palette: 10 Semantic Technical Themes -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}" CornerRadius="20" Padding="12,7" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Current}, Path=[Showcase.Header.Accent]}" VerticalAlignment="Center" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" Margin="0,0,9,0" FontSize="10" FontWeight="SemiBold"/>
                            <Button x:Name="BtnPalette1" Width="20" Height="20" Background="#FF7900" BorderThickness="0" Margin="3,0" Cursor="Hand" Click="OnPaletteButtonClick" Tag="#FF7900" ToolTip="Default Orange" attached:BorderElement.CornerRadius="10"/>
                            <Button x:Name="BtnPalette2" Width="20" Height="20" Background="#0284C7" BorderThickness="0" Margin="3,0" Cursor="Hand" Click="OnPaletteButtonClick" Tag="#0284C7" ToolTip="Ocean Blue" attached:BorderElement.CornerRadius="10"/>
                            <Button x:Name="BtnPalette3" Width="20" Height="20" Background="#16A34A" BorderThickness="0" Margin="3,0" Cursor="Hand" Click="OnPaletteButtonClick" Tag="#16A34A" ToolTip="Forest Green" attached:BorderElement.CornerRadius="10"/>
                            <Button x:Name="BtnPalette4" Width="20" Height="20" Background="#DC2626" BorderThickness="0" Margin="3,0" Cursor="Hand" Click="OnPaletteButtonClick" Tag="#DC2626" ToolTip="Ruby Crimson" attached:BorderElement.CornerRadius="10"/>
                            <Button x:Name="BtnPalette5" Width="20" Height="20" Background="#475569" BorderThickness="0" Margin="3,0" Cursor="Hand" Click="OnPaletteButtonClick" Tag="#475569" ToolTip="CAD Slate" attached:BorderElement.CornerRadius="10"/>
                            <Button x:Name="BtnPalette6" Width="20" Height="20" Background="#8B5CF6" BorderThickness="0" Margin="3,0" Cursor="Hand" Click="OnPaletteButtonClick" Tag="#8B5CF6" ToolTip="Midnight Purple" attached:BorderElement.CornerRadius="10"/>
                            <Button x:Name="BtnPalette7" Width="20" Height="20" Background="#0D9488" BorderThickness="0" Margin="3,0" Cursor="Hand" Click="OnPaletteButtonClick" Tag="#0D9488" ToolTip="Teal Cyan" attached:BorderElement.CornerRadius="10"/>
                            <Button x:Name="BtnPalette8" Width="20" Height="20" Background="#D97706" BorderThickness="0" Margin="3,0" Cursor="Hand" Click="OnPaletteButtonClick" Tag="#D97706" ToolTip="Amber Gold" attached:BorderElement.CornerRadius="10"/>
                            <Button x:Name="BtnPalette9" Width="20" Height="20" Background="#DB2777" BorderThickness="0" Margin="3,0" Cursor="Hand" Click="OnPaletteButtonClick" Tag="#DB2777" ToolTip="Rose Pink" attached:BorderElement.CornerRadius="10"/>
                            <Button x:Name="BtnPalette10" Width="20" Height="20" Background="#3B82F6" BorderThickness="0" Margin="3,0" Cursor="Hand" Click="OnPaletteButtonClick" Tag="#3B82F6" ToolTip="Royal Blue" attached:BorderElement.CornerRadius="10"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Actions: Dark/Light Mode & Quick Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}" CornerRadius="8" Padding="2" Margin="0,0,10,0" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="1">
                        <ComboBox x:Name="LanguageSelector" Width="112" Height="30" BorderThickness="0" Background="Transparent" SelectionChanged="OnLanguageSelectionChanged" SelectedIndex="1" ToolTip="Language">
                            <ComboBoxItem Content="English" Tag="en-US" />
                            <ComboBoxItem Content="Tiếng Việt" Tag="vi-VN" />
                        </ComboBox>
                    </Border>
                    <Border Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}" CornerRadius="18" Padding="10,5" Margin="0,0,12,0" BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <icons:Icon Kind="LightMode" Width="14" Height="14" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <ui:ToggleSwitch x:Name="ToggleDarkSwitch" IsChecked="{Binding IsDarkMode, Mode=TwoWay}" PreviewMouseLeftButtonDown="OnDarkModeTogglePreviewMouseDown" OnContent="" OffContent="" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <icons:Icon Kind="DarkMode" Width="14" Height="14" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource CONCOST.Button.Primary}"
                            attached:BorderElement.CornerRadius="8"
                            attached:IconElement.Kind="Check"
                            Command="{Binding ShowToastCommand}"
                            Content="{Binding Source={x:Static services:LocalizationManager.Current}, Path=[Showcase.Header.TestToast]}"
                            Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="220" MaxWidth="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CONCOST.Brush.Surface}"
                    BorderBrush="{DynamicResource CONCOST.Brush.Border}"
                    BorderThickness="0,0,1,0"
                    Padding="16,16,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Modern iOS/macOS Style Segmented Control (All · Basic · Custom) -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}"
                            BorderBrush="{DynamicResource CONCOST.Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3"
                            Margin="0,0,0,14"
                            Height="40">
                        <Grid>
                            <Grid.Resources>
                                <Style x:Key="SegmentedTabItem" TargetType="{x:Type RadioButton}">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Foreground" Value="{DynamicResource CONCOST.Brush.TextSecondary}"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type RadioButton}">
                                                <Border x:Name="pillBorder"
                                                        Background="Transparent"
                                                        CornerRadius="6"
                                                        Margin="1,0"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Margin="4,0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource CONCOST.Brush.SurfaceHover}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource CONCOST.Brush.TextPrimary}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource CONCOST.Brush.Surface}"/>
                                                        <Setter TargetName="pillBorder" Property="BorderBrush" Value="{DynamicResource CONCOST.Brush.Border}"/>
                                                        <Setter TargetName="pillBorder" Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource CONCOST.Brush.Primary}"/>
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Grid.Resources>

                            <WrapPanel Orientation="Horizontal">
                                <RadioButton Content="{Binding Source={x:Static services:LocalizationManager.Current}, Path=[Showcase.Filters.All]}"
                                             IsChecked="{Binding SelectedCategory, Converter={StaticResource SelectedCategoryConverter}, ConverterParameter=All, Mode=TwoWay}"
                                             GroupName="ShowcaseCategoryGroup"
                                             Command="{Binding SetCategoryCommand}"
                                             CommandParameter="All"
                                             Style="{StaticResource SegmentedTabItem}"/>
                                <RadioButton Content="{Binding Source={x:Static services:LocalizationManager.Current}, Path=[Showcase.Filters.Basic]}"
                                             IsChecked="{Binding SelectedCategory, Converter={StaticResource SelectedCategoryConverter}, ConverterParameter='Basic Controls', Mode=TwoWay}"
                                             GroupName="ShowcaseCategoryGroup"
                                             Command="{Binding SetCategoryCommand}"
                                             CommandParameter="Basic Controls"
                                             Style="{StaticResource SegmentedTabItem}"/>
                                <RadioButton Content="{Binding Source={x:Static services:LocalizationManager.Current}, Path=[Showcase.Filters.Custom]}"
                                             IsChecked="{Binding SelectedCategory, Converter={StaticResource SelectedCategoryConverter}, ConverterParameter='Custom Controls', Mode=TwoWay}"
                                             GroupName="ShowcaseCategoryGroup"
                                             Command="{Binding SetCategoryCommand}"
                                             CommandParameter="Custom Controls"
                                             Style="{StaticResource SegmentedTabItem}"/>
                                <RadioButton Content="{Binding Source={x:Static services:LocalizationManager.Current}, Path=[Showcase.Filters.Data]}"
                                             IsChecked="{Binding SelectedCategory, Converter={StaticResource SelectedCategoryConverter}, ConverterParameter='Data Controls', Mode=TwoWay}"
                                             GroupName="ShowcaseCategoryGroup"
                                             Command="{Binding SetCategoryCommand}"
                                             CommandParameter="Data Controls"
                                             Style="{StaticResource SegmentedTabItem}"/>
                                <RadioButton Content="{Binding Source={x:Static services:LocalizationManager.Current}, Path=[Showcase.Filters.Layout]}"
                                             IsChecked="{Binding SelectedCategory, Converter={StaticResource SelectedCategoryConverter}, ConverterParameter='Layout &amp; Shell', Mode=TwoWay}"
                                             GroupName="ShowcaseCategoryGroup"
                                             Command="{Binding SetCategoryCommand}"
                                             CommandParameter="Layout &amp; Shell"
                                             Style="{StaticResource SegmentedTabItem}"/>
                                <RadioButton Content="{Binding Source={x:Static services:LocalizationManager.Current}, Path=[Showcase.Filters.Input]}"
                                             IsChecked="{Binding SelectedCategory, Converter={StaticResource SelectedCategoryConverter}, ConverterParameter='Input &amp; Drag', Mode=TwoWay}"
                                             GroupName="ShowcaseCategoryGroup"
                                             Command="{Binding SetCategoryCommand}"
                                             CommandParameter="Input &amp; Drag"
                                             Style="{StaticResource SegmentedTabItem}"/>
                                <RadioButton Content="{Binding Source={x:Static services:LocalizationManager.Current}, Path=[Showcase.Filters.Effects]}"
                                             IsChecked="{Binding SelectedCategory, Converter={StaticResource SelectedCategoryConverter}, ConverterParameter='Effects', Mode=TwoWay}"
                                             GroupName="ShowcaseCategoryGroup"
                                             Command="{Binding SetCategoryCommand}"
                                             CommandParameter="Effects"
                                             Style="{StaticResource SegmentedTabItem}"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Catalog heading -->
                    <Grid Grid.Row="1" Margin="2,0,2,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Current}, Path=[Showcase.Catalog.Title]}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" />
                            <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Current}, Path=[Showcase.Catalog.Subtitle]}" FontSize="12" Foreground="{DynamicResource CONCOST.Brush.TextPrimary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}" CornerRadius="10" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CatalogCountText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" />
                        </Border>
                    </Grid>

                    <!-- Search Box -->
                    <TextBox Grid.Row="2"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             attached:InfoElement.Placeholder="{Binding Source={x:Static services:LocalizationManager.Current}, Path=[Showcase.Catalog.Search]}"
                             attached:IconElement.Kind="Search"
                             attached:BorderElement.CornerRadius="8"
                             MinHeight="40"
                             Margin="0,0,0,12"/>

                    <!-- Component Catalog List with Smooth Pixel Scrolling -->
                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding FilteredItems}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             SelectionChanged="OnCatalogSelectionChanged"
                             BorderThickness="0"
                             Background="Transparent"
                             FocusVisualStyle="{x:Null}"
                             ScrollViewer.CanContentScroll="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CONCOST.ScrollBar.Base}">
                                <Setter Property="Width" Value="8" />
                                <Setter Property="MinWidth" Value="8" />
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}" CornerRadius="8" Margin="0,0,11,0">
                                        <icons:Icon x:Name="CatalogIcon" Kind="{Binding Icon}" Width="15" Height="15" Foreground="{Binding IconAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock x:Name="CatalogName" Grid.Column="1" Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource CONCOST.Brush.TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True">
                                    <Setter TargetName="CatalogIcon" Property="Foreground" Value="{DynamicResource CONCOST.Brush.Primary}" />
                                    <Setter TargetName="CatalogName" Property="Foreground" Value="{DynamicResource CONCOST.Brush.Primary}" />
                                    <Setter TargetName="CatalogName" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Padding" Value="9,6"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="itemBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Border x:Name="selectionMark" Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch" CornerRadius="2" Background="{DynamicResource CONCOST.Brush.Primary}" Opacity="0" />
                                                    <ContentPresenter Margin="7,0,0,0" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource CONCOST.Brush.SurfaceHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource CONCOST.Brush.SurfaceSecondary}"/>
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource CONCOST.Brush.Primary}"/>
                                                    <Setter TargetName="selectionMark" Property="Opacity" Value="1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- CENTER SHOWCASE VIEW (Demo Stage + extended-properties dock) -->
            <Grid Grid.Column="1" Background="{DynamicResource CONCOST.Brush.Background}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Hero Header Banner -->
                <Border Grid.Row="0"
                        Background="{DynamicResource CONCOST.Brush.Surface}"
                        BorderBrush="{DynamicResource CONCOST.Brush.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="24,16,24,16">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                <Border Background="{DynamicResource CONCOST.Brush.Primary}" CornerRadius="6" Padding="10,0" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedItem.DisplayCategory}" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource CONCOST.Brush.White}" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding SelectedItem.DisplayName}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource CONCOST.Brush.TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedItem.DisplayDescription}" FontSize="13" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}" CornerRadius="10" Width="44" Height="44" VerticalAlignment="Center">
                            <icons:Icon Kind="{Binding SelectedItem.Icon}" Width="22" Height="22" Foreground="{DynamicResource CONCOST.Brush.Primary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Scrollable showcase stage -->
                <ScrollViewer x:Name="ShowcaseScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24,20,24,30">
                    <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,32">
                        <ContentPresenter Content="{Binding SelectedItem.Content}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </ScrollViewer>

            </Grid>

        </Grid>

                <!-- GROWL NOTIFICATION HOST (Top-Right Floating Stack) -->
        <StackPanel x:Name="PART_GrowlHost" Grid.Row="1" 
                    HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="0,20,24,0" Panel.ZIndex="999" />

        <!-- TOAST CONTAINER (Replaced by PART_GrowlHost with smooth animations) -->
        <ItemsControl Grid.Row="1" Visibility="Collapsed"
                      ItemsSource="{Binding Source={x:Static services:ToastService.Current}, Path=ActiveToasts}"
                      HorizontalAlignment="Right" VerticalAlignment="Top"
                      Margin="0,20,24,0" IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource CONCOST.Brush.Surface}"
                            BorderBrush="{DynamicResource CONCOST.Brush.Primary}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18,12"
                            Margin="0,0,0,10"
                            MinWidth="300">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.15" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="Normal" Foreground="{DynamicResource CONCOST.Brush.Primary}" FontSize="13"/>
                            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource CONCOST.Brush.TextPrimary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>

