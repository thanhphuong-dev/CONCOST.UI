<Window x:Class="CONCOST.UI.Showcase.MainWindow"
        Icon="Assets/AppIcon.png"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CONCOST.UI.Showcase"
        xmlns:ui="clr-namespace:CONCOST.UI.Controls;assembly=CONCOST.UI"
        xmlns:icons="clr-namespace:CONCOST.UI.Icons;assembly=CONCOST.UI"
        xmlns:attached="clr-namespace:CONCOST.UI.AttachedProperties;assembly=CONCOST.UI"
        xmlns:services="clr-namespace:CONCOST.UI.Services;assembly=CONCOST.UI"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static services:LocalizationManager.Current}, Path=[Showcase.WindowTitle]}" Height="840" Width="1440"
        MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Inter, Roboto, Arial"
        Background="{DynamicResource CONCOST.Brush.Background}"
        Foreground="{DynamicResource CONCOST.Brush.TextPrimary}">

    <Window.DataContext>
        <local:ShowcaseViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:SelectedCategoryConverter x:Key="SelectedCategoryConverter" />

        <Style x:Key="Showcase.OverviewCardButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource CONCOST.Brush.SurfaceSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CONCOST.Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="CardChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardChrome" Property="Background" Value="{DynamicResource CONCOST.Brush.SurfaceHover}" />
                                <Setter TargetName="CardChrome" Property="BorderBrush" Value="{DynamicResource CONCOST.Brush.BorderHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardChrome" Property="Background" Value="{DynamicResource CONCOST.Brush.SurfacePressed}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CardChrome" Property="BorderBrush" Value="{DynamicResource CONCOST.Brush.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pinned Nav Item RadioButton (Proper Active Sync) -->
        <Style x:Key="Showcase.PinnedNavRadio" TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="ShowcasePinnedNav" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="chrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="activeIndicator" Grid.Column="0" Width="3" Height="14" CornerRadius="1.5"
                                        Background="{DynamicResource CONCOST.Brush.Primary}" Margin="0,0,8,0" Opacity="0" />
                                <icons:Icon Grid.Column="1" Kind="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(attached:IconElement.Kind)}"
                                            Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" x:Name="navIcon" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="2" Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="Medium"
                                           Foreground="{DynamicResource CONCOST.Brush.TextPrimary}" x:Name="navText" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chrome" Property="Background" Value="{DynamicResource CONCOST.Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="chrome" Property="Background" Value="{DynamicResource CONCOST.Brush.SurfaceSecondary}" />
                                <Setter TargetName="activeIndicator" Property="Opacity" Value="1" />
                                <Setter TargetName="navIcon" Property="Foreground" Value="{DynamicResource CONCOST.Brush.Primary}" />
                                <Setter TargetName="navText" Property="Foreground" Value="{DynamicResource CONCOST.Brush.TextPrimary}" />
                                <Setter TargetName="navText" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category Item Style in ListBox -->
        <Style x:Key="Showcase.CategoryItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="itemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="activeIndicator" Grid.Column="0" Width="3" Height="14" CornerRadius="1.5"
                                        Background="{DynamicResource CONCOST.Brush.Primary}" Margin="0,0,8,0" Opacity="0" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12" FontWeight="Normal"
                                           Foreground="{DynamicResource CONCOST.Brush.TextPrimary}" x:Name="itemText"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource CONCOST.Brush.SurfaceHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource CONCOST.Brush.SurfaceSecondary}" />
                                <Setter TargetName="activeIndicator" Property="Opacity" Value="1" />
                                <Setter TargetName="itemText" Property="Foreground" Value="{DynamicResource CONCOST.Brush.TextPrimary}" />
                                <Setter TargetName="itemText" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category Expander Style -->
        <Style x:Key="Showcase.CategoryExpanderStyle" TargetType="{x:Type Expander}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,1,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <StackPanel>
                                <ToggleButton x:Name="ExpanderHeader"
                                              IsChecked="{Binding Path=IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Cursor="Hand"
                                              FocusVisualStyle="{x:Null}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border x:Name="hdrBorder" Background="Transparent" CornerRadius="6" Padding="8,7" Margin="0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <icons:Icon Kind="{Binding Icon}" Width="15" Height="15"
                                                                Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" x:Name="catIcon"
                                                                Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource CONCOST.Brush.TextPrimary}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="2" Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}"
                                                            BorderBrush="{DynamicResource CONCOST.Brush.BorderSubtle}" BorderThickness="1"
                                                            CornerRadius="8" Padding="6,1" Margin="6,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" />
                                                    </Border>
                                                    <Path x:Name="chevron" Grid.Column="3" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource CONCOST.Brush.TextSecondary}"
                                                          StrokeThickness="1.5" VerticalAlignment="Center" Margin="4,0,2,0" RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="-90" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="hdrBorder" Property="Background" Value="{DynamicResource CONCOST.Brush.SurfaceHover}" />
                                                    <Setter TargetName="catIcon" Property="Foreground" Value="{DynamicResource CONCOST.Brush.Primary}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="chevron" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0" />
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter TargetName="catIcon" Property="Foreground" Value="{DynamicResource CONCOST.Brush.Primary}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpanderContent"
                                                  Margin="12,2,0,4"
                                                  Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP BAR: 54px Sleek Enterprise Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource CONCOST.Brush.Surface}"
                BorderBrush="{DynamicResource CONCOST.Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Brand Section: 260px matching sidebar -->
                    <ColumnDefinition Width="260" />
                    <!-- Center Omnibox Search -->
                    <ColumnDefinition Width="*" />
                    <!-- Right Utility Tooling -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 1. Brand Logo & Product Metadata -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/AppIcon.png" Width="30" Height="30" Margin="0,0,9,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="CONCOST" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource CONCOST.Brush.TextPrimary}" />
                            <TextBlock Text=".UI" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource CONCOST.Brush.Primary}" />
                            <Border Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}"
                                    BorderBrush="{DynamicResource CONCOST.Brush.BorderSubtle}" BorderThickness="1"
                                    CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.0.1" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationManager.Current}, Path=[Showcase.Brand.Caption]}" FontSize="9.5" FontWeight="Medium" Foreground="{DynamicResource CONCOST.Brush.TextTertiary}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- 2. Center: Global Omnibox Search -->
                <Border Grid.Column="1"
                        Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}"
                        BorderBrush="{DynamicResource CONCOST.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="34"
                        MaxWidth="400"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="10,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <icons:Icon Kind="Search" Width="14" Height="14" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="12"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource CONCOST.Brush.TextPrimary}"
                                 attached:InfoElement.Placeholder="Tìm kiếm thành phần trong thư viện..." />
                        <Border Grid.Column="2"
                                Background="{DynamicResource CONCOST.Brush.Surface}"
                                BorderBrush="{DynamicResource CONCOST.Brush.BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,1"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding CatalogCountText}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- 3. Right: Palette, Language, Dark Mode & Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Compact Theme Accent Palette Strip -->
                    <Border Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}"
                            BorderBrush="{DynamicResource CONCOST.Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="6,3"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            ToolTip="Chọn màu sắc chủ đạo giao diện">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnPalette1" Width="15" Height="15" Background="#FF7900" BorderThickness="0" Margin="2,0" Cursor="Hand" Click="OnPaletteButtonClick" Tag="#FF7900" ToolTip="Cam kỹ thuật (Default)" attached:BorderElement.CornerRadius="7.5"/>
                            <Button x:Name="BtnPalette2" Width="15" Height="15" Background="#0284C7" BorderThickness="0" Margin="2,0" Cursor="Hand" Click="OnPaletteButtonClick" Tag="#0284C7" ToolTip="Xanh đại dương" attached:BorderElement.CornerRadius="7.5"/>
                            <Button x:Name="BtnPalette3" Width="15" Height="15" Background="#16A34A" BorderThickness="0" Margin="2,0" Cursor="Hand" Click="OnPaletteButtonClick" Tag="#16A34A" ToolTip="Xanh lá công trình" attached:BorderElement.CornerRadius="7.5"/>
                            <Button x:Name="BtnPalette4" Width="15" Height="15" Background="#DC2626" BorderThickness="0" Margin="2,0" Cursor="Hand" Click="OnPaletteButtonClick" Tag="#DC2626" ToolTip="Đỏ thẫm kết cấu" attached:BorderElement.CornerRadius="7.5"/>
                            <Button x:Name="BtnPalette5" Width="15" Height="15" Background="#475569" BorderThickness="0" Margin="2,0" Cursor="Hand" Click="OnPaletteButtonClick" Tag="#475569" ToolTip="Xám CAD Slate" attached:BorderElement.CornerRadius="7.5"/>
                            <Button x:Name="BtnPalette6" Width="15" Height="15" Background="#8B5CF6" BorderThickness="0" Margin="2,0" Cursor="Hand" Click="OnPaletteButtonClick" Tag="#8B5CF6" ToolTip="Tím hoàng hôn" attached:BorderElement.CornerRadius="7.5"/>
                            <Button x:Name="BtnPalette7" Width="15" Height="15" Background="#0D9488" BorderThickness="0" Margin="2,0" Cursor="Hand" Click="OnPaletteButtonClick" Tag="#0D9488" ToolTip="Xanh ngọc Teal" attached:BorderElement.CornerRadius="7.5"/>
                            <Button x:Name="BtnPalette8" Width="15" Height="15" Background="#D97706" BorderThickness="0" Margin="2,0" Cursor="Hand" Click="OnPaletteButtonClick" Tag="#D97706" ToolTip="Hổ phách Amber" attached:BorderElement.CornerRadius="7.5"/>
                            <Button x:Name="BtnPalette9" Width="15" Height="15" Background="#DB2777" BorderThickness="0" Margin="2,0" Cursor="Hand" Click="OnPaletteButtonClick" Tag="#DB2777" ToolTip="Hồng hoa sen" attached:BorderElement.CornerRadius="7.5"/>
                            <Button x:Name="BtnPalette10" Width="15" Height="15" Background="#3B82F6" BorderThickness="0" Margin="2,0" Cursor="Hand" Click="OnPaletteButtonClick" Tag="#3B82F6" ToolTip="Xanh hoàng gia" attached:BorderElement.CornerRadius="7.5"/>
                        </StackPanel>
                    </Border>

                    <!-- Language Switcher (116px Width to prevent truncation!) -->
                    <Border Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}"
                            BorderBrush="{DynamicResource CONCOST.Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="2"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <ComboBox x:Name="LanguageSelector" Width="116" Height="26" BorderThickness="0" Background="Transparent" SelectionChanged="OnLanguageSelectionChanged" SelectedIndex="1" ToolTip="Ngôn ngữ hiển thị">
                            <ComboBoxItem Content="English" Tag="en-US" />
                            <ComboBoxItem Content="Tiếng Việt" Tag="vi-VN" />
                        </ComboBox>
                    </Border>

                    <!-- Dark / Light Mode Switcher -->
                    <Border Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}"
                            BorderBrush="{DynamicResource CONCOST.Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="8,4"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            ToolTip="Chuyển đổi giao diện Sáng / Tối">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <icons:Icon Kind="LightMode" Width="13" Height="13" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <ui:ToggleSwitch x:Name="ToggleDarkSwitch" IsChecked="{Binding IsDarkMode, Mode=TwoWay}" PreviewMouseLeftButtonDown="OnDarkModeTogglePreviewMouseDown" OnContent="" OffContent="" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <icons:Icon Kind="DarkMode" Width="13" Height="13" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Ghost Toast Action Button -->
                    <Button Style="{StaticResource CONCOST.Button.Secondary}"
                            attached:BorderElement.CornerRadius="6"
                            attached:IconElement.Kind="Bell"
                            Command="{Binding ShowToastCommand}"
                            ToolTip="Thử kích hoạt thông báo Toast"
                            Padding="8,5"
                            Height="30"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="240" MaxWidth="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR: Hierarchical Category Accordion Navigation -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CONCOST.Brush.Surface}"
                    BorderBrush="{DynamicResource CONCOST.Brush.Border}"
                    BorderThickness="0,0,1,0"
                    Padding="14,14,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Pinned Starters (Overview / Docs) -->
                        <RowDefinition Height="Auto" />
                        <!-- Section Label -->
                        <RowDefinition Height="Auto" />
                        <!-- Categories Tree / Expander List -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 1. Pinned Starters (Overview & Docs) with Exact Active State Binding -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <RadioButton Style="{StaticResource Showcase.PinnedNavRadio}"
                                     IsChecked="{Binding IsOverviewActive, Mode=OneWay}"
                                     Command="{Binding SelectItemCommand}"
                                     CommandParameter="Overview"
                                     attached:IconElement.Kind="Home"
                                     Content="Trang chủ &amp; Khám phá" />
                        <RadioButton Style="{StaticResource Showcase.PinnedNavRadio}"
                                     IsChecked="{Binding IsDocumentationActive, Mode=OneWay}"
                                     Command="{Binding SelectItemCommand}"
                                     CommandParameter="Documentation"
                                     attached:IconElement.Kind="FileCode"
                                     Content="Tài liệu &amp; Tokens" />
                    </StackPanel>

                    <!-- 2. Section Header: Danh mục thành phần -->
                    <Grid Grid.Row="1" Margin="4,0,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="DANH MỤC THÀNH PHẦN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CONCOST.Brush.TextTertiary}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding CatalogCountText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource CONCOST.Brush.TextTertiary}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- 3. Collapsible Category Groups (Direct IsExpanded local binding) -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  FocusVisualStyle="{x:Null}">
                        <ScrollViewer.Resources>
                            <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource CONCOST.ScrollBar.Base}">
                                <Setter Property="Width" Value="6" />
                                <Setter Property="MinWidth" Value="6" />
                            </Style>
                        </ScrollViewer.Resources>

                        <ItemsControl ItemsSource="{Binding CategoryGroups}" Margin="0,0,2,16">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                                              Style="{StaticResource Showcase.CategoryExpanderStyle}">
                                        <ListBox ItemsSource="{Binding Items}"
                                                 SelectedItem="{Binding DataContext.SelectedItem, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                 SelectionChanged="OnCatalogSelectionChanged"
                                                 ItemContainerStyle="{StaticResource Showcase.CategoryItemStyle}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 FocusVisualStyle="{x:Null}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled" />
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT SHOWCASE VIEW (Stage + Hero Header) -->
            <Grid Grid.Column="1" Background="{DynamicResource CONCOST.Brush.Background}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Modern Hero Header Banner (Shown for controls, hidden on Overview) -->
                <Border Grid.Row="0"
                        Visibility="{Binding ShowHeroHeaderBanner, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource CONCOST.Brush.Surface}"
                        BorderBrush="{DynamicResource CONCOST.Brush.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="28,14,28,14">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <!-- Breadcrumb Navigation -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <icons:Icon Kind="Home" Width="12" Height="12" Foreground="{DynamicResource CONCOST.Brush.TextTertiary}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Thư viện" FontSize="11" Foreground="{DynamicResource CONCOST.Brush.TextTertiary}" VerticalAlignment="Center"/>
                                <TextBlock Text=" / " FontSize="11" Foreground="{DynamicResource CONCOST.Brush.TextTertiary}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedItem.DisplayCategory}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Text=" / " FontSize="11" Foreground="{DynamicResource CONCOST.Brush.TextTertiary}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedItem.DisplayName}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource CONCOST.Brush.TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Control Title & Category Pill Badge -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                <TextBlock Text="{Binding SelectedItem.DisplayName}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource CONCOST.Brush.TextPrimary}" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}"
                                        BorderBrush="{DynamicResource CONCOST.Brush.Border}" BorderThickness="1"
                                        CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedItem.DisplayCategory}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding SelectedItem.DisplayDescription}" FontSize="12.5" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" TextWrapping="Wrap" LineHeight="19" MaxWidth="900"/>
                        </StackPanel>

                        <!-- Right: Icon Pill -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource CONCOST.Brush.SurfaceSecondary}"
                                BorderBrush="{DynamicResource CONCOST.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="8" Width="36" Height="36"
                                VerticalAlignment="Center">
                            <icons:Icon Kind="{Binding SelectedItem.Icon}" Width="18" Height="18" Foreground="{DynamicResource CONCOST.Brush.TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Scrollable showcase stage -->
                <ScrollViewer x:Name="ShowcaseScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="28,20,28,30">
                    <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,32">
                        <ContentPresenter Content="{Binding SelectedItem.Content}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </ScrollViewer>

            </Grid>

        </Grid>

        <!-- GROWL NOTIFICATION HOST (Top-Right Floating Stack) -->
        <StackPanel x:Name="PART_GrowlHost" Grid.Row="1" 
                    HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Margin="0,20,24,0" Panel.ZIndex="999" />

    </Grid>
</Window>
